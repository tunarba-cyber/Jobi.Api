@* ===========================================================================
   Views/Home/Index.cshtml
   ===========================================================================

   1) Add this at the very top of the file, replacing the existing @{ ... } block:
*@

@model LinkedIn.MVC.Models.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "Home";
    var summary = Model.Summary;
}

@*
   ---------------------------------------------------------------------------
   2) "Most Demanding Categories" - replace the six hardcoded
      <div class="card-style-one ..."> blocks (lines ~98-145) with this loop.
   ---------------------------------------------------------------------------
*@

<div class="card-wrapper row justify-content-center mt-75 lg-mt-40 md-mt-10">
    @if (summary.FeaturedCategories.Count == 0)
    {
        <div class="col-12 text-center">
            <p class="text-md">No categories published yet.</p>
        </div>
    }
    else
    {
        @foreach (var (category, index) in summary.FeaturedCategories.Select((c, i) => (c, i)))
        {
            <div class="card-style-one text-center mt-20 wow fadeInUp" data-wow-delay="@($"0.{index}s")">
                <a asp-controller="Job" asp-action="JobGrid" asp-route-categorySlug="@category.Slug"
                   class="bg wrapper @(index == 0 ? "active" : "")">
                    <div class="icon d-flex align-items-center justify-content-center">
                        <img src="~/images/lazy.svg"
                             data-src="@(string.IsNullOrWhiteSpace(category.IconUrl) ? "/images/icon/icon_01.svg" : category.IconUrl)"
                             alt="@category.Name" class="lazy-img">
                    </div>
                    <div class="title fw-500">@category.Name</div>
                    <div class="total-job">@category.JobCount Jobs</div>
                </a>
            </div>
        }
    }
</div>

@*
   ---------------------------------------------------------------------------
   3) Hero search dropdowns - replace the hardcoded <option> lists so the
      search actually posts to the job list.
   ---------------------------------------------------------------------------
*@

<form asp-controller="Job" asp-action="JobList" method="get">
    <div class="row">
        <div class="col-md-5">
            <div class="input-box">
                <div class="label">What are you looking for?</div>
                <input type="text" name="search" class="form-control" placeholder="Job title or keyword">
            </div>
        </div>
        <div class="col-md-4">
            <div class="input-box border-left">
                <div class="label">Category</div>
                <select name="categorySlug" class="nice-select lg">
                    <option value="">All categories</option>
                    @foreach (var category in Model.AllCategories)
                    {
                        <option value="@category.Slug">@category.Name</option>
                    }
                </select>
            </div>
        </div>
        <div class="col-md-3">
            <button type="submit" class="fw-500 text-uppercase h-100 tran3s search-btn">Search</button>
        </div>
    </div>
</form>

@*
   ---------------------------------------------------------------------------
   4) Counters - wherever the template hardcodes numbers (e.g. "7,096 jobs"),
      use these:
   ---------------------------------------------------------------------------
*@

<span>@summary.TotalActiveJobs.ToString("N0")</span>   @* live jobs *@
<span>@summary.TotalCompanies.ToString("N0")</span>     @* companies *@
<span>@summary.TotalCategories.ToString("N0")</span>    @* categories *@

@*
   ---------------------------------------------------------------------------
   5) Featured jobs carousel - use the same card loop as the job list snippet,
      over summary.FeaturedJobs.
   ---------------------------------------------------------------------------
*@

@foreach (var job in summary.FeaturedJobs)
{
    <div class="job-list-one style-two position-relative border-style mb-20">
        <div class="row justify-content-between align-items-center">
            <div class="col-md-5">
                <div class="job-title d-flex align-items-center">
                    <a asp-controller="Job" asp-action="JobDetails" asp-route-slug="@job.Slug" class="logo">
                        <img src="~/images/lazy.svg" data-src="/images/logo/media_22.png" alt="@job.CompanyName" class="lazy-img m-auto">
                    </a>
                    <div class="split-box1">
                        <span class="job-duration fw-500">@job.JobType.ToLabel()</span>
                        <a asp-controller="Job" asp-action="JobDetails" asp-route-slug="@job.Slug" class="title fw-500 tran3s">@job.Title</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-6">
                <div class="job-location">@job.Location</div>
                <div class="job-salary">
                    <span class="fw-500 text-dark">@job.SalaryRange</span> . @job.ExperienceLevel.ToLabel()
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="btn-group d-flex align-items-center justify-content-sm-end xs-mt-20">
                    <a asp-controller="Job" asp-action="JobDetails" asp-route-slug="@job.Slug" class="apply-btn text-center tran3s">APPLY</a>
                </div>
            </div>
        </div>
    </div>
}

@*
   ---------------------------------------------------------------------------
   6) Latest blog posts (Model.LatestBlogs) - drop into the blog section.
   ---------------------------------------------------------------------------
*@

@foreach (var post in Model.LatestBlogs)
{
    <article class="blog-meta-one mt-30">
        <figure class="post-img m0">
            <a asp-controller="Blog" asp-action="Details" asp-route-slug="@post.Slug" class="w-100 d-block">
                <img src="~/images/lazy.svg"
                     data-src="@(string.IsNullOrWhiteSpace(post.ImageUrl) ? "/images/blog/blog_img_01.jpg" : post.ImageUrl)"
                     alt="@post.Title" class="lazy-img w-100 tran4s">
            </a>
        </figure>
        <div class="post-data">
            <div class="date">@(post.PublishedAt?.ToString("dd MMM, yyyy") ?? "Draft")</div>
            <a asp-controller="Blog" asp-action="Details" asp-route-slug="@post.Slug">
                <h4 class="tran3s mb-20">@post.Title</h4>
            </a>
            <p>@post.Summary</p>
        </div>
    </article>
}
