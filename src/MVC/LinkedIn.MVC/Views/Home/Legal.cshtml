@{
    ViewData["Title"] = "Terms & Privacy";
}

<div class="inner-banner-one position-relative">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 m-auto text-center">
                <div class="title-two"><h2 class="text-white">Terms &amp; Privacy</h2></div>
            </div>
        </div>
    </div>
</div>

<section class="pt-100 lg-pt-80 pb-150 lg-pb-80">
    <div class="container">
        <div class="row">
            <div class="col-xl-8 m-auto">
                <h4 id="terms">Terms of use</h4>
                <p>Jobi is a job board connecting candidates and employers. By creating an account you agree to provide accurate information, to use the service lawfully, and not to post content that is false, offensive, or infringes anyone's rights. Employers are responsible for the jobs they post and for how they treat applicants. We may suspend accounts or remove content that breaks these terms.</p>
                <p>Jobi is provided as is. We don't guarantee that a job posting is genuine, or that any application results in an interview or an offer.</p>

                <h4 id="privacy" class="mt-40">Privacy</h4>
                <p><strong>What we store:</strong> your name and email, your profile, CV and photo, applications, messages, posts, and the people and companies you follow.</p>
                <p><strong>Who can see it:</strong> profiles, posts and company pages are visible to other members. Your CV link is shared with employers you apply to. Messages are visible only to the people in the conversation.</p>
                <p><strong>Sign-in with Google:</strong> we receive your name and verified email address from Google and nothing else.</p>
                <p><strong>AI assistants:</strong> when you use a "Write with AI" button, the text you entered is sent to an AI provider to produce the draft.</p>
                <p><strong>Your choices:</strong> you can edit your profile at any time. To have your account and data deleted, contact us.</p>

                <h4 class="mt-40">Cookies</h4>
                <p>We use cookies to keep you signed in and to protect forms against forgery. We don't use advertising cookies.</p>

                <h4 class="mt-40">Contact</h4>
                <p>Questions about these terms? Use our <a asp-controller="Home" asp-action="ContactUs">contact form</a>.</p>
            </div>
        </div>
    </div>
</section>