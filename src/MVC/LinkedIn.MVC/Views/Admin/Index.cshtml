@using LinkedIn.MVC.Models.Api
@model dynamic

@{
    ViewData["Title"] = "Admin Dashboard";
    var recentBlogs = Model?.RecentBlogs as IReadOnlyList<BlogListItemDto>;
    var categories = Model?.Categories as IReadOnlyList<BlogCategoryDto>;
    int totalBlogs = Model?.TotalBlogs ?? 0;
    int totalCategories = Model?.TotalCategories ?? 0;
}

<!-- Banner Section -->
<div class="inner-banner-one position-relative">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 m-auto text-center">
                <div class="title-two"><h2 class="text-white">Admin Dashboard</h2></div>
            </div>
        </div>
    </div>
</div>

<section class="pt-100 lg-pt-80 pb-150 lg-pb-80">
    <div class="container">
        <!-- Statistics Section -->
        <div class="d-flex justify-content-between align-items-center flex-wrap mb-40">
            <div>
                <h3 class="fw-700" style="color:var(--jb-primary);">Overview</h3>
                <p class="text-muted mb-0">Content at a glance</p>
            </div>
            <div class="mt-3 mt-md-0">
                <a asp-action="CreateBlog" class="btn-one"><i class="bi bi-plus-lg"></i> Create Blog</a>
            </div>
        </div>

        <!-- Stats Grid -->
        <div class="row mb-50">
            <div class="col-md-6 col-lg-3 mb-20">
                <div class="jb-stat jb-rise">
                    <div class="d-flex align-items-center justify-content-between gap-3">
                        <div>
                            <div class="jb-stat-value">@totalBlogs</div>
                            <p class="jb-stat-label">Total Blogs</p>
                        </div>
                        <span class="jb-stat-icon"><i class="bi bi-journal-text"></i></span>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 mb-20">
                <div class="jb-stat jb-rise">
                    <div class="d-flex align-items-center justify-content-between gap-3">
                        <div>
                            <div class="jb-stat-value">@totalCategories</div>
                            <p class="jb-stat-label">Categories</p>
                        </div>
                        <span class="jb-stat-icon"><i class="bi bi-tags"></i></span>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 mb-20">
                <div class="jb-stat jb-rise">
                    <div class="d-flex align-items-center justify-content-between gap-3">
                        <div>
                            <div class="jb-stat-value">@(recentBlogs?.Count(b => b.PublishedAt.HasValue) ?? 0)</div>
                            <p class="jb-stat-label">Published</p>
                        </div>
                        <span class="jb-stat-icon"><i class="bi bi-check2-circle"></i></span>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 mb-20">
                <div class="jb-stat jb-rise">
                    <div class="d-flex align-items-center justify-content-between gap-3">
                        <div>
                            <div class="jb-stat-value">@(recentBlogs?.Count(b => !b.PublishedAt.HasValue) ?? 0)</div>
                            <p class="jb-stat-label">Drafts</p>
                        </div>
                        <span class="jb-stat-icon"><i class="bi bi-pencil-square"></i></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Blogs Table -->
        <div class="row">
            <div class="col-lg-8">
                <div class="d-flex justify-content-between align-items-center mb-30">
                    <h4>Recent Blogs</h4>
                    <a asp-action="Blogs" class="btn btn-outline-secondary btn-sm">View All</a>
                </div>

                @if (recentBlogs?.Count() == 0)
                {
                    <div class="text-center">
                        <div class="jb-empty">
                            <div class="jb-empty-icon"><i class="bi bi-journal-plus"></i></div>
                            <h4>No blog posts yet</h4>
                            <a asp-action="CreateBlog" class="btn-one mt-20 d-inline-block">Create your first blog</a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Category</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var blog in recentBlogs?.Take(8) ?? [])
                                {
                                    <tr>
                                        <td class="fw-500">@blog.Title</td>
                                        <td>@(blog.CategoryName ?? "-")</td>
                                        <td>
                                            @if (blog.PublishedAt.HasValue)
                                            {
                                                <span class="badge bg-success">Published</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Draft</span>
                                            }
                                        </td>
                                        <td class="text-muted">@blog.PublishedAt?.ToString("dd MMM yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <!-- Quick Links -->
                <div class="jb-card p-20 mb-30">
                    <h5 class="mb-20 fw-700">Quick Links</h5>
                    <a asp-action="CreateBlog" class="btn-one d-block mb-15 text-center">Create Blog Post</a>
                    <a asp-action="Categories" class="btn btn-outline-secondary d-block text-center">Manage Categories</a>
                </div>

                <!-- Categories List -->
                <div class="jb-card p-20">
                <h5 class="mb-20 fw-700">Categories</h5>
                @if (categories?.Count() == 0)
                {
                    <p class="text-muted mb-0">No categories yet.</p>
                }
                else
                {
                    <div class="list-wrap">
                        @foreach (var category in categories?.Take(10) ?? [])
                        {
                            <div class="d-flex justify-content-between align-items-center mb-15 pb-15 border-bottom">
                                <span class="fw-500">@category.Name</span>
                                <span class="jb-chip">@category.Count</span>
                            </div>
                        }
                    </div>
                    <a asp-action="Categories" class="btn btn-outline-secondary btn-sm w-100 mt-10">View All Categories</a>
                }
                </div>
            </div>
        </div>
    </div>
</section>
