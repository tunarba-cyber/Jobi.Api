@using LinkedIn.MVC.Models.Api
@{
    ViewData["Title"] = "New Blog";
}
@{
    var categories = ViewBag.Categories as IReadOnlyList<BlogCategoryDto> ?? Array.Empty<BlogCategoryDto>();
}

<section class="pt-100 lg-pt-80 pb-150 lg-pb-80">
    <div class="container">
        <h2 class="mb-20">New Blog</h2>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form asp-action="CreateBlog" method="post" enctype="multipart/form-data">
            <div class="mb-15">
                <label class="form-label">Title</label>
                <input name="Title" class="form-control" required maxlength="200" />
            </div>
            <div class="mb-15">
                <label class="form-label">Summary</label>
                <textarea name="Summary" class="form-control" rows="3" required maxlength="500"></textarea>
            </div>
            <div class="mb-15">
                <label class="form-label">Category</label>
                <select name="CategoryId" class="form-control" required>
                    @foreach (var c in categories)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            <div class="mb-15">
                <label class="form-label">Content</label>
                <textarea name="Content" class="form-control" rows="10" required></textarea>
            </div>
            <div class="mb-15">
                <label class="form-label">Cover Image (optional)</label>
                <input type="file" name="image" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
            </div>
            <div class="form-check mb-10">
                <input type="checkbox" name="IsFeatured" value="true" class="form-check-input" id="isFeatured" />
                <label class="form-check-label" for="isFeatured">Featured</label>
            </div>
            <div class="form-check mb-20">
                <input type="checkbox" name="PublishNow" value="true" class="form-check-input" id="publishNow" checked />
                <label class="form-check-label" for="publishNow">Publish now</label>
            </div>
            <button type="submit" class="btn-one">Create</button>
        </form>
    </div>
</section>