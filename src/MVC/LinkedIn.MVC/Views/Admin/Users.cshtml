@using System.Security.Claims
@using LinkedIn.MVC.Models.Api
@model PagedResult<AdminUserDto>
@{
    ViewData["Title"] = "Manage Users";
    var me = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var search = Context.Request.Query["search"].ToString();
    var roleFilter = Context.Request.Query["role"].ToString();
}

<div class="inner-banner-one position-relative">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 m-auto text-center">
                <div class="title-two"><h2 class="text-white">Manage Users</h2></div>
            </div>
        </div>
    </div>
</div>

<section class="pt-100 lg-pt-80 pb-150 lg-pb-80">
    <div class="container">
        <form asp-action="Users" method="get" class="row g-2 mb-40">
            <div class="col-md-5"><input name="search" value="@search" class="form-control" placeholder="Name or email" /></div>
            <div class="col-md-4">
                <select name="role" class="form-select">
                    <option value="">All roles</option>
                    @foreach (UserRole r in Enum.GetValues<UserRole>())
                    {
                        <option value="@r" selected="@(roleFilter == r.ToString())">@r</option>
                    }
                </select>
            </div>
            <div class="col-md-3"><button type="submit" class="btn-one w-100">Filter</button></div>
        </form>

        @if (Model.Items.Count == 0)
        {
            <p class="text-muted">No users found.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Joined</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                        @foreach (var u in Model.Items)
                        {
                            var isMe = u.Id == me;
                            <tr>
                                <td class="fw-500">@u.FirstName @u.LastName @(isMe ? "(you)" : "")</td>
                                <td>@u.Email</td>
                                <td>
                                    <form asp-action="ChangeUserRole" method="post">
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <select name="role" class="form-select form-select-sm" style="width:auto;" disabled="@isMe"
                                                onchange="if(confirm('Change this user\'s role to ' + this.options[this.selectedIndex].text + '?')){this.form.submit();}else{this.value='@((int)u.Role)';}">
                                            @foreach (UserRole r in Enum.GetValues<UserRole>())
                                            {
                                                <option value="@((int)r)" selected="@(u.Role == r)">@r</option>
                                            }
                                        </select>
                                    </form>
                                </td>
                                <td>
                                    @if (u.IsSuspended)
                                    {
                                        <span class="badge bg-danger">Suspended</span>
                                    }
                                    else if (!u.EmailConfirmed)
                                    {

                                        <span class="badge bg-warning text-dark">Unconfirmed</span>
                                    }
                                    else
                                    {

                                        <span class="badge bg-success">Active</span>
                                    }
                                </td>
                                <td>@u.CreatedAtUtc.ToString("dd MMM yyyy")</td>
                                <td class="text-end text-nowrap">
                                    @if (!isMe)
                                    {
                                        @if (u.IsSuspended)
                                        {
                                            <form asp-action="ReinstateUser" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@u.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-success">Reinstate</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="SuspendUser" method="post" class="d-inline" onsubmit="return confirm('Suspend this user?');">
                                                <input type="hidden" name="id" value="@u.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Suspend</button>
                                            </form>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <ul class="pagination-one d-flex justify-content-center style-none mt-30">
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="@(p == Model.Page ? "active" : "")"><a asp-action="Users" asp-route-page="@p" asp-route-search="@search" asp-route-role="@roleFilter">@p</a></li>
                    }
                </ul>
            }
        }
    </div>
</section>