@using LinkedIn.MVC.Models.Api
@model PagedResult<CategoryDto>
@{
    ViewData["Title"] = "Job Categories";
}

<div class="inner-banner-one position-relative">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 m-auto text-center">
                <div class="title-two"><h2 class="text-white">Job Categories</h2></div>
            </div>
        </div>
    </div>
</div>

<section class="pt-100 lg-pt-80 pb-150 lg-pb-80">
    <div class="container">
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger mb-20">@error</div>
        }

        <div class="mb-40">
            <form asp-action="CreateJobCategory" method="post">
                <div class="row g-2">
                    <div class="col-sm-4">
                        <input name="Name" class="form-control" placeholder="Category name" required maxlength="100" />
                    </div>
                    <div class="col-sm-3">
                        <input name="Slug" class="form-control" placeholder="Slug (optional)" />
                    </div>
                    <div class="col-sm-2">
                        <input name="DisplayOrder" type="number" class="form-control" placeholder="Order" value="0" />
                    </div>
                    <div class="col-sm-2 form-check pt-10">
                        <input type="checkbox" name="IsFeatured" value="true" class="form-check-input" id="jcFeatured" />
                        <label class="form-check-label" for="jcFeatured">Featured</label>
                    </div>
                    <div class="col-sm-1">
                        <button type="submit" class="btn-one w-100">Add</button>
                    </div>
                </div>
            </form>
        </div>

        @if (Model.Items.Count == 0)
        {
            <p class="text-muted">No job categories yet.</p>
        }
        else
        {
            <table class="table align-middle">
                <thead><tr><th>Name</th><th>Slug</th><th>Order</th><th>Featured</th><th>Active</th><th>Jobs</th><th></th></tr></thead>
                <tbody>
                    @foreach (var c in Model.Items)
                    {
                        <tr>
                            <td>@c.Name</td>
                            <td><code>@c.Slug</code></td>
                            <td>@c.DisplayOrder</td>
                            <td>@(c.IsFeatured ? "Yes" : "No")</td>
                            <td>@(c.IsActive ? "Yes" : "No")</td>
                            <td>@c.JobCount</td>
                            <td>
                                <form asp-action="DeleteJobCategory" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this category?');">
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <a asp-action="EditJobCategory" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</section>