@using LinkedIn.MVC.Models.Api
@model PagedResult<JobDto>
@{
    ViewData["Title"] = "Moderate Jobs";
}

<div class="inner-banner-one position-relative">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 m-auto text-center">
                <div class="title-two"><h2 class="text-white">Moderate Jobs</h2></div>
            </div>
        </div>
    </div>
</div>

<section class="pt-100 lg-pt-80 pb-150 lg-pb-80">
    <div class="container">
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger mb-20">@error</div>
        }

        <form asp-action="Jobs" method="get" class="row g-2 mb-40">
            <div class="col-md-5"><input name="search" class="form-control" placeholder="Title or company" /></div>
            <div class="col-md-4">
                <select name="status" class="form-select">
                    <option value="">All statuses</option>
                    @foreach (JobStatus s in Enum.GetValues<JobStatus>())
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-3"><button type="submit" class="btn-one w-100">Filter</button></div>
        </form>

        @if (Model.Items.Count == 0)
        {
            <p class="text-muted">No jobs found.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Job</th><th>Company</th><th>Status</th><th>Posted</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                        @foreach (var j in Model.Items)
                        {
                            <tr>
                                <td class="fw-500"><a asp-controller="Job" asp-action="JobDetails" asp-route-slug="@j.Slug">@j.Title</a></td>
                                <td>@j.CompanyName</td>
                                <td>
                                    <span class="badge @(j.Status switch { JobStatus.Active => "bg-success", JobStatus.Closed => "bg-secondary", _ => "bg-warning text-dark" })">@j.Status</span>
                                </td>
                                <td>@j.PostedAgo</td>
                                <td class="text-end text-nowrap">
                                    <form asp-action="SetJobStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@j.Id" />
                                        <select name="status" class="form-select form-select-sm d-inline-block" style="width:auto;" onchange="this.form.submit()">
                                            @foreach (JobStatus s in Enum.GetValues<JobStatus>())
                                            {
                                                <option value="@s" selected="@(j.Status == s)">@s</option>
                                            }
                                        </select>
                                    </form>
                                    <form asp-action="AdminDeleteJob" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this job?');">
                                        <input type="hidden" name="id" value="@j.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <ul class="pagination-one d-flex justify-content-center style-none mt-30">
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="@(p == Model.Page ? "active" : "")"><a asp-action="Jobs" asp-route-page="@p">@p</a></li>
                    }
                </ul>
            }
        }
    </div>
</section>