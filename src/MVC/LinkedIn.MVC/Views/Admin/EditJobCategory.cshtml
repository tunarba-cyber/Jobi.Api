@using LinkedIn.MVC.Models.Api
@model CategoryDto
@{
    ViewData["Title"] = "Edit Category";
}

<div class="inner-banner-one position-relative">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 m-auto text-center">
                <div class="title-two"><h2 class="text-white">Edit Category</h2></div>
            </div>
        </div>
    </div>
</div>

<section class="pt-100 lg-pt-80 pb-150 lg-pb-80">
    <div class="container">
        <form asp-action="EditJobCategory" asp-route-id="@Model.Id" method="post">
            <div class="mb-15">
                <label class="form-label">Name</label>
                <input name="Name" class="form-control" value="@Model.Name" required maxlength="100" />
            </div>
            <div class="mb-15">
                <label class="form-label">Slug</label>
                <input name="Slug" class="form-control" value="@Model.Slug" />
            </div>
            <div class="mb-15">
                <label class="form-label">Display Order</label>
                <input name="DisplayOrder" type="number" class="form-control" value="@Model.DisplayOrder" />
            </div>
            <div class="form-check mb-10">
                <input type="checkbox" name="IsFeatured" value="true" class="form-check-input" checked="@Model.IsFeatured" />
                <label class="form-check-label">Featured</label>
            </div>
            <div class="form-check mb-20">
                <input type="checkbox" name="IsActive" value="true" class="form-check-input" checked="@Model.IsActive" />
                <label class="form-check-label">Active</label>
            </div>
            <button type="submit" class="btn-one">Save</button>
        </form>
    </div>
</section>