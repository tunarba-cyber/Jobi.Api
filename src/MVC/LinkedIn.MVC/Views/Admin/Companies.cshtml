@using LinkedIn.MVC.Models.Api
@model PagedResult<AdminCompanyDto>
@{
    ViewData["Title"] = "Moderate Companies"; var search = Context.Request.Query["search"].ToString();
}

<div class="inner-banner-one position-relative">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 m-auto text-center">
                <div class="title-two"><h2 class="text-white">Moderate Companies</h2></div>
            </div>
        </div>
    </div>
</div>

<section class="pt-100 lg-pt-80 pb-150 lg-pb-80">
    <div class="container">
        <form asp-action="Companies" method="get" class="row g-2 mb-40">
            <div class="col-md-9"><input name="search" value="@search" class="form-control" placeholder="Company name" /></div>
            <div class="col-md-3"><button type="submit" class="btn-one w-100">Search</button></div>
        </form>

        @if (Model.Items.Count == 0)
        {
            <p class="text-muted">No companies found.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Company</th><th>Website</th><th>Jobs</th><th>Created</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.Items)
                        {
                            <tr>
                                <td class="fw-500"><a asp-controller="Company" asp-action="Details" asp-route-slug="@c.Slug">@c.Name</a></td>
                                <td>@c.WebsiteUrl</td>
                                <td>@c.JobCount</td>
                                <td>@c.CreatedAtUtc.ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    <form asp-action="DeleteCompany" method="post" class="d-inline"
                                          onsubmit="return confirm('Remove this company and close all its jobs?');">
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.TotalPages > 1)
            {
                <ul class="pagination-one d-flex justify-content-center style-none mt-30">
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="@(p == Model.Page ? "active" : "")"><a asp-action="Companies" asp-route-page="@p" asp-route-search="@search">@p</a></li>
                    }
                </ul>
            }
        }
    </div>
</section>