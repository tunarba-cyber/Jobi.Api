@using LinkedIn.MVC.Models
@using LinkedIn.MVC.Models.Api
@model PagedResult<ContactMessageDto>
@{
    ViewData["Title"] = "Contact Inbox";
    var unreadOnly = Context.Request.Query["unreadOnly"].ToString() == "true";
    var topic = Context.Request.Query["topic"].ToString();
}

<div class="inner-banner-one position-relative">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 m-auto text-center">
                <div class="title-two"><h2 class="text-white">Contact Inbox</h2></div>
            </div>
        </div>
    </div>
</div>

<section class="pt-100 lg-pt-80 pb-150 lg-pb-80">
    <div class="container">
        <div class="jb-section-head">
            <div>
                <h4>Messages</h4>
                <p class="jb-sub">@Model.Items.Count on this page</p>
            </div>
            <div class="jb-pills" style="flex-wrap:wrap; border-radius:18px;">
                <a asp-action="ContactMessages" class="@(!unreadOnly && topic == "" ? "active" : "")">All</a>
                <a asp-action="ContactMessages" asp-route-unreadOnly="true" class="@(unreadOnly ? "active" : "")">Unread</a>
                <a asp-action="ContactMessages" asp-route-topic="Reports" class="@(topic == "Reports" ? "active" : "")">Reports only</a>
                <a asp-action="ContactMessages" asp-route-topic="General" class="@(topic == "General" ? "active" : "")">General</a>
                <a asp-action="ContactMessages" asp-route-topic="Bug" class="@(topic == "Bug" ? "active" : "")">Bugs</a>
            </div>
        </div>

        @if (Model.Items.Count == 0)
        {
            <div class="jb-empty">
                <div class="jb-empty-icon"><i class="bi bi-inbox"></i></div>
                <h4>No messages</h4>
                <p>Nothing matches this filter right now.</p>
            </div>
        }
        else
        {
            @foreach (var m in Model.Items)
            {
                <div class="jb-row jb-rise" style="@(!m.IsRead ? "border-left:4px solid var(--jb-accent); background:#FBFEEA;" : "")">
                    <div class="d-flex justify-content-between flex-wrap gap-3">
                        <div class="d-flex gap-3" style="min-width:0;">
                            <span class="jb-avatar soft">@(string.IsNullOrEmpty(m.Name) ? "?" : m.Name[0].ToString().ToUpperInvariant())</span>
                            <div style="min-width:0;">
                                <div class="fw-600" style="color:var(--jb-primary);">
                                    @(string.IsNullOrWhiteSpace(m.Subject) ? "(no subject)" : m.Subject)
                                    @if (!m.IsRead)
                                    {
                                        <span class="jb-status is-shortlisted ms-2">New</span>
                                    }
                                </div>
                                <div class="mt-5 d-flex flex-wrap align-items-center gap-2">
                                    <span class="jb-status @(m.Topic.StartsWith("Report") ? "is-rejected" : "is-closed")">@ContactTopics.Label(m.Topic)</span>
                                    @if (Url.IsLocalUrl(m.Reference))
                                    {
                                        <a href="@m.Reference" target="_blank" rel="noopener" class="small"><i class="bi bi-box-arrow-up-right"></i> Open reported page</a>
                                    }
                                </div>
                                <div class="text-muted small mt-5">@m.Name · @m.Email · @m.CreatedAtUtc.ToString("dd MMM yyyy, HH:mm")</div>
                            </div>
                        </div>
                        <div class="text-nowrap">
                            <a href="mailto:@m.Email?subject=Re: @m.Subject" class="btn btn-sm btn-outline-primary"><i class="bi bi-reply"></i> Reply</a>
                            @if (!m.IsRead)
                            {
                                <form asp-action="MarkContactRead" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@m.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-check2"></i> Mark read</button>
                                </form>
                            }
                            <form asp-action="DeleteContactMessage" method="post" class="d-inline" onsubmit="return confirm('Delete this message?');">
                                <input type="hidden" name="id" value="@m.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</button>
                            </form>
                        </div>
                    </div>
                    <details class="mt-3">
                        <summary style="cursor:pointer; color:var(--jb-primary); font-weight:500;">Read message</summary>
                        <div class="jb-msg mt-3" style="max-width:100%; white-space:pre-wrap;">@m.Body</div>
                    </details>
                </div>
            }

            @if (Model.TotalPages > 1)
            {
                <ul class="pagination-one d-flex justify-content-center style-none mt-30">
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="@(p == Model.Page ? "active" : "")"><a asp-action="ContactMessages" asp-route-page="@p" asp-route-unreadOnly="@(unreadOnly ? "true" : null)" asp-route-topic="@(topic == "" ? null : topic)">@p</a></li>
                    }
                </ul>
            }
        }
    </div>
</section>