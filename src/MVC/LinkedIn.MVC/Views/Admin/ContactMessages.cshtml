@using LinkedIn.MVC.Models.Api
@model PagedResult<ContactMessageDto>
@{
    ViewData["Title"] = "Contact Inbox";
    var unreadOnly = Context.Request.Query["unreadOnly"].ToString() == "true";
}

<div class="inner-banner-one position-relative">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 m-auto text-center">
                <div class="title-two"><h2 class="text-white">Contact Inbox</h2></div>
            </div>
        </div>
    </div>
</div>

<section class="pt-100 lg-pt-80 pb-150 lg-pb-80">
    <div class="container">
        <div class="mb-30">
            <a asp-action="ContactMessages" class="btn @(unreadOnly ? "btn-outline-secondary" : "btn-secondary") btn-sm">All</a>
            <a asp-action="ContactMessages" asp-route-unreadOnly="true" class="btn @(unreadOnly ? "btn-secondary" : "btn-outline-secondary") btn-sm">Unread only</a>
        </div>

        @if (Model.Items.Count == 0)
        {
            <p class="text-muted">No messages.</p>
        }
        else
        {
            @foreach (var m in Model.Items)
            {
                <div class="job-list-one style-two position-relative border-style mb-15 p-20">
                    <div class="d-flex justify-content-between flex-wrap">
                        <div>
                            <div class="fw-500">
                                @(string.IsNullOrWhiteSpace(m.Subject) ? "(no subject)" : m.Subject)
                                @if (!m.IsRead)
                                {
                                    <span class="badge bg-primary ms-2">New</span>
                                }
                            </div>
                            <div class="text-muted small">@m.Name · @m.Email · @m.CreatedAtUtc.ToString("dd MMM yyyy, HH:mm")</div>
                        </div>
                        <div class="text-nowrap mt-2 mt-md-0">
                            <a href="mailto:@m.Email?subject=Re: @m.Subject" class="btn btn-sm btn-outline-primary">Reply</a>
                            @if (!m.IsRead)
                            {
                                <form asp-action="MarkContactRead" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@m.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Mark read</button>
                                </form>
                            }
                            <form asp-action="DeleteContactMessage" method="post" class="d-inline" onsubmit="return confirm('Delete this message?');">
                                <input type="hidden" name="id" value="@m.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    </div>
                    <details class="mt-10">
                        <summary>Read message</summary>
                        <p style="white-space:pre-wrap;" class="mt-10 mb-0">@m.Body</p>
                    </details>
                </div>
            }

            @if (Model.TotalPages > 1)
            {
                <ul class="pagination-one d-flex justify-content-center style-none mt-30">
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="@(p == Model.Page ? "active" : "")"><a asp-action="ContactMessages" asp-route-page="@p" asp-route-unreadOnly="@(unreadOnly ? "true" : null)">@p</a></li>
                    }
                </ul>
            }
        }
    </div>
</section>