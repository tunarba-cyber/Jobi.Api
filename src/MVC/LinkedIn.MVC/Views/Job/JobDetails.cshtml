@* ===========================================================================
   Views/Job/JobDetails.cshtml
   ===========================================================================

   1) Replace the top @{ ... } block with:
*@

@using LinkedIn.MVC.Models.Api
@model LinkedIn.MVC.Models.ViewModels.JobDetailsViewModel
@{
    var job = Model.Job;
    ViewData["Title"] = job.Title;
}

@*
   ---------------------------------------------------------------------------
   2) Banner / job title area.
   ---------------------------------------------------------------------------
*@

<div class="title-two">
    <h2 class="text-white">@job.Title</h2>
</div>
<div class="text-white mt-20">
    @job.CompanyName . @job.Location . @job.JobType.ToLabel()
</div>

@*
   ---------------------------------------------------------------------------
   3) Job description body - replace the lorem-ipsum block.
      Description is stored as HTML by the API, so it is rendered raw. If you
      ever let untrusted users post jobs, sanitise it (HtmlSanitizer) before
      this line - Html.Raw on user input is an XSS hole.
   ---------------------------------------------------------------------------
*@

<div class="job-post-det">
    @Html.Raw(job.Description)
</div>

@*
   ---------------------------------------------------------------------------
   4) Right-hand "Job Overview" card.
   ---------------------------------------------------------------------------
*@

<div class="job-overview d-flex justify-content-between align-items-center pt-30 pb-15">
    <ul class="style-none d-flex flex-wrap align-items-center justify-content-between w-100">
        <li>
            <span>Category</span>
            <div>@job.CategoryName</div>
        </li>
        <li>
            <span>Job Type</span>
            <div>@job.JobType.ToLabel()</div>
        </li>
        <li>
            <span>Experience</span>
            <div>@job.ExperienceLevel.ToLabel()</div>
        </li>
        <li>
            <span>Salary</span>
            <div>@job.SalaryRange</div>
        </li>
        <li>
            <span>Vacancies</span>
            <div>@job.VacancyCount</div>
        </li>
        <li>
            <span>Deadline</span>
            <div>@(job.ApplicationDeadline?.ToString("dd MMM, yyyy") ?? "Open")</div>
        </li>
        <li>
            <span>Posted</span>
            <div>@job.PostedAgo</div>
        </li>
    </ul>
</div>

@if (job.Status != JobStatus.Active)
{
    <div class="alert alert-warning mt-20">This job is no longer accepting applications.</div>
}

@*
   ---------------------------------------------------------------------------
   5) Company block - links to the company page (GET /api/companies/{slug}).
   ---------------------------------------------------------------------------
*@

<div class="company-side-detail">
    <div class="name fw-500 text-dark text-center">@job.CompanyName</div>
    <a asp-controller="Company" asp-action="Details" asp-route-slug="@job.CompanySlug"
       class="btn-ten fw-500 text-white w-100 text-center tran3s mt-25">View company</a>
</div>

@*
   ---------------------------------------------------------------------------
   6) Related jobs.
   ---------------------------------------------------------------------------
*@

@if (Model.RelatedJobs.Count > 0)
{
    <div class="related-job-item mt-60">
        <h3 class="mb-30">Related Jobs</h3>
        @foreach (var related in Model.RelatedJobs)
        {
            <div class="job-list-one style-two position-relative border-style mb-20">
                <div class="row justify-content-between align-items-center">
                    <div class="col-md-7">
                        <div class="job-title d-flex align-items-center">
                            <div class="split-box1">
                                <span class="job-duration fw-500">@related.JobType.ToLabel()</span>
                                <a asp-action="JobDetails" asp-route-slug="@related.Slug" class="title fw-500 tran3s">@related.Title</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="job-location">@related.Location</div>
                        <div class="job-salary"><span class="fw-500 text-dark">@related.SalaryRange</span></div>
                    </div>
                </div>
            </div>
        }
    </div>
}
