@model LinkedIn.MVC.Models.ViewModels.JobDetailsViewModel
@{
    ViewData["Title"] = Model.Job.Title;
}

<div class="inner-banner-one position-relative">
    <div class="container">
        <div class="position-relative">
            <div class="row">
                <div class="col-xl-6 m-auto text-center">
                    <div class="title-two"><h2 class="text-white">Job Details</h2></div>
                    <p class="text-lg text-white mt-30 lg-mt-20">Here will be your company job details & requirements</p>
                </div>
            </div>
        </div>
    </div>
    <img src="~/images/lazy.svg" data-src="~/images/shape/shape_02.svg" alt="" class="lazy-img shapes shape_01">
    <img src="~/images/lazy.svg" data-src="~/images/shape/shape_03.svg" alt="" class="lazy-img shapes shape_02">
</div>

<section class="job-details pt-100 lg-pt-80 pb-130 lg-pb-80">
    <div class="container">
        <div class="row">
            <div class="col-xxl-9 col-xl-8">
                <div class="details-post-data me-xxl-5 pe-xxl-4">
                    <div class="post-date">
                        @Model.Job.PostedAgo by
                        <a asp-controller="Company" asp-action="Details" asp-route-slug="@Model.Job.CompanySlug" class="fw-500 text-dark">@Model.Job.CompanyName</a>
                    </div>
                    <h3 class="post-title">@Model.Job.Title</h3>

                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <span class="jb-chip"><i class="bi bi-briefcase"></i> @Model.Job.JobType</span>
                        <span class="jb-chip"><i class="bi bi-geo-alt"></i> @Model.Job.Location</span>
                        <span class="jb-chip"><i class="bi bi-bar-chart"></i> @Model.Job.ExperienceLevel</span>
                        <span class="jb-chip"><i class="bi bi-cash-stack"></i> @Model.Job.SalaryRange</span>
                    </div>

                    <div class="jb-card p-30 mt-40 lg-mt-30">
                        <div class="d-flex align-items-center gap-3 mb-20">
                            <span class="jb-stat-icon" style="display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:12px;background:var(--jb-accent-soft);color:var(--jb-primary);"><i class="bi bi-card-text"></i></span>
                            <h4 class="m-0 fw-700" style="color:var(--jb-primary);">Job Description</h4>
                        </div>
                        <p class="mb-0" style="white-space:pre-wrap;">@Model.Job.Description</p>
                    </div>
                </div>
            </div>

            <div class="col-xxl-3 col-xl-4">
                <div class="jb-card p-30 ms-xl-5 ms-xxl-0 lg-mt-50" style="position:sticky; top:100px;">
                    <div class="text-center">
                        <div class="jb-avatar xl mb-15" style="border-radius:20px;">@(string.IsNullOrEmpty(Model.Job.CompanyName) ? "?" : Model.Job.CompanyName[0].ToString().ToUpperInvariant())</div>
                        <div class="fw-600 fs-5 mb-15" style="color:var(--jb-primary);">@Model.Job.CompanyName</div>
                        <a asp-controller="Company" asp-action="Details" asp-route-slug="@Model.Job.CompanySlug" class="btn btn-outline-secondary btn-sm w-100">View company</a>
                    </div>

                    <ul class="style-none mt-30 mb-0">
                        <li class="d-flex justify-content-between gap-3 py-2 border-bottom"><span class="text-muted">Salary</span><span class="fw-500 text-end">@Model.Job.SalaryRange</span></li>
                        <li class="d-flex justify-content-between gap-3 py-2 border-bottom"><span class="text-muted">Expertise</span><span class="fw-500 text-end">@Model.Job.ExperienceLevel</span></li>
                        <li class="d-flex justify-content-between gap-3 py-2 border-bottom"><span class="text-muted">Location</span><span class="fw-500 text-end">@Model.Job.Location</span></li>
                        <li class="d-flex justify-content-between gap-3 py-2 border-bottom"><span class="text-muted">Job Type</span><span class="fw-500 text-end">@Model.Job.JobType</span></li>
                        <li class="d-flex justify-content-between gap-3 py-2 border-bottom"><span class="text-muted">Posted</span><span class="fw-500 text-end">@Model.Job.PostedAgo</span></li>
                        <li class="d-flex justify-content-between gap-3 py-2"><span class="text-muted">Vacancies</span><span class="fw-500 text-end">@Model.Job.VacancyCount</span></li>
                    </ul>

                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <a href="#" data-bs-toggle="modal" data-bs-target="#loginModal" class="btn-one w-100 mt-25 text-center">Apply Now</a>
                    }
                    else if (User.IsInRole("Candidate"))
                    {
                        <button type="button" class="btn-one w-100 mt-25" data-bs-toggle="modal" data-bs-target="#applyModal">Apply Now</button>
                        <div class="mt-15 text-center">
                            <partial name="_SaveJobButton" model="new LinkedIn.MVC.Models.ViewModels.SaveJobButtonViewModel(Model.Job.Id, Model.SavedJobIds.Contains(Model.Job.Id))" />
                            <span class="ms-1">@(Model.SavedJobIds.Contains(Model.Job.Id) ? "Saved" : "Save for later")</span>
                        </div>
                    }
                    else
                    {
                        <p class="text-center text-muted mt-25 mb-0"><i class="bi bi-info-circle"></i> Employer accounts can't apply to jobs.</p>
                    }

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="text-center mt-15">
                            <a asp-controller="Home" asp-action="ContactUs" asp-route-topic="ReportJob"
                               asp-route-reference="@Url.Action("JobDetails", "Job", new { slug = Model.Job.Slug })" class="text-muted small"><i class="bi bi-flag"></i> Report this job</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@if (Model.RelatedJobs.Any())
{
    <section class="related-job-section pt-90 lg-pt-70 pb-120 lg-pb-70">
        <div class="container">
            <div class="position-relative">
                <div class="title-three text-center text-md-start mb-55 lg-mb-40">
                    <h2 class="main-font">Related Jobs</h2>
                </div>

                <div class="related-job-slider">
                    @foreach (var job in Model.RelatedJobs)
                    {
                        <div class="item">
                            <div class="job-list-two style-two position-relative">
                                <a asp-controller="Job" asp-action="JobDetails" asp-route-slug="@job.Slug" class="logo">
                                    <img src="~/images/logo/media_22.png" alt="" class="m-auto">
                                </a>
                                <partial name="_SaveJobButton" model="new LinkedIn.MVC.Models.ViewModels.SaveJobButtonViewModel(job.Id, Model.SavedJobIds.Contains(job.Id))" />
                                <div><a asp-controller="Job" asp-action="JobDetails" asp-route-slug="@job.Slug" class="job-duration fw-500">@job.JobType</a></div>
                                <div><a asp-controller="Job" asp-action="JobDetails" asp-route-slug="@job.Slug" class="title fw-500 tran3s">@job.Title</a></div>
                                <div class="job-salary"><span class="fw-500 text-dark">@job.SalaryRange</span></div>
                                <div class="d-flex align-items-center justify-content-between mt-auto">
                                    <div class="job-location"><a asp-controller="Job" asp-action="JobDetails" asp-route-slug="@job.Slug">@job.Location</a></div>
                                    <a asp-controller="Job" asp-action="JobDetails" asp-route-slug="@job.Slug" class="apply-btn text-center tran3s">APPLY</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <ul class="slider-arrows slick-arrow-one color-two d-flex justify-content-center style-none sm-mt-20">
                    <li class="prev_e slick-arrow"><i class="bi bi-arrow-left"></i></li>
                    <li class="next_e slick-arrow"><i class="bi bi-arrow-right"></i></li>
                </ul>
            </div>
        </div>
    </section>
}

@if (User.IsInRole("Candidate"))
{
    <div class="modal fade" id="applyModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content p-3" style="border-radius:16px; border:0; box-shadow:var(--jb-shadow-lg);">
                <div class="modal-header border-0">
                    <h4 class="modal-title fw-700" style="color:var(--jb-primary);">Apply for @Model.Job.Title</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Application" asp-action="Apply" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="JobId" value="@Model.Job.Id" />
                    <input type="hidden" name="JobSlug" value="@Model.Job.Slug" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-500 mb-0">Cover letter (optional)</label>
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        data-ai-url="@Url.Action("CoverLetter", "Ai")"
                                        data-ai-target="[name=CoverLetter]"
                                        data-ai-values='@System.Text.Json.JsonSerializer.Serialize(new { jobTitle = Model.Job.Title, companyName = Model.Job.CompanyName, jobDescription = Model.Job.Description })'>
                                    ✨ Draft with AI
                                </button>
                            </div>
                            <textarea name="CoverLetter" class="form-control" rows="5" maxlength="4000" placeholder="Tell the employer why you're a good fit"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-500">CV (PDF, DOC or DOCX, max 5 MB)</label>
                            <input type="file" name="Resume" class="form-control" accept=".pdf,.doc,.docx" />
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="submit" class="btn-one w-100">Submit application</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_AiAssist" />
}