@* ===========================================================================
   Views/Job/JobList.cshtml  (JobGrid.cshtml uses the same model - reuse the
   loop with the grid card markup instead of the list card markup)
   ===========================================================================

   1) Replace the top @{ ... } block with:
*@

@using LinkedIn.MVC.Models.Api
@model LinkedIn.MVC.Models.ViewModels.JobListViewModel
@{
    ViewData["Title"] = "Job Listing";
    var f = Model.Filters;
}

@*
   ---------------------------------------------------------------------------
   2) Banner search form (lines ~26-56) - replace the <form action="..."> block.
   ---------------------------------------------------------------------------
*@

<form asp-controller="Job" asp-action="JobList" method="get">
    <div class="row">
        <div class="col-md-5">
            <div class="input-box">
                <div class="label">What are you looking for?</div>
                <input type="text" name="search" value="@f.Search" class="form-control" placeholder="Job title or keyword">
            </div>
        </div>
        <div class="col-md-4">
            <div class="input-box border-left">
                <div class="label">Category</div>
                <select name="categorySlug" class="nice-select lg">
                    <option value="">All categories</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Slug" selected="@(category.Slug == f.CategorySlug)">@category.Name</option>
                    }
                </select>
            </div>
        </div>
        <div class="col-md-3">
            <button type="submit" class="fw-500 text-uppercase h-100 tran3s search-btn">Search</button>
        </div>
    </div>
</form>

@*
   ---------------------------------------------------------------------------
   3) Left sidebar filters - one GET form wrapping the filter widgets. Keep the
      template's markup, just make the inputs real.
   ---------------------------------------------------------------------------
*@

<form asp-controller="Job" asp-action="JobList" method="get" id="filterForm">
    <input type="hidden" name="search" value="@f.Search" />

    <div class="filter-block bottom-line pb-25">
        <a class="filter-title fw-500 text-dark" data-bs-toggle="collapse" href="#collapseCategory" role="button">Category</a>
        <div class="collapse show" id="collapseCategory">
            <div class="main-body">
                <ul class="style-none filter-input">
                    @foreach (var category in Model.Categories)
                    {
                        <li>
                            <input type="radio" name="categorySlug" value="@category.Slug"
                                   checked="@(category.Slug == f.CategorySlug)"
                                   onchange="document.getElementById('filterForm').submit()">
                            <label>@category.Name <span>@category.JobCount</span></label>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="filter-block bottom-line pb-25 mt-25">
        <a class="filter-title fw-500 text-dark" data-bs-toggle="collapse" href="#collapseJobType" role="button">Job Type</a>
        <div class="collapse show" id="collapseJobType">
            <div class="main-body">
                <ul class="style-none filter-input">
                    @foreach (JobType type in Enum.GetValues<JobType>())
                    {
                        <li>
                            <input type="radio" name="jobType" value="@type"
                                   checked="@(f.JobType == type)"
                                   onchange="document.getElementById('filterForm').submit()">
                            <label>@type.ToLabel()</label>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="filter-block bottom-line pb-25 mt-25">
        <a class="filter-title fw-500 text-dark" data-bs-toggle="collapse" href="#collapseExperience" role="button">Experience</a>
        <div class="collapse show" id="collapseExperience">
            <div class="main-body">
                <ul class="style-none filter-input">
                    @foreach (ExperienceLevel level in Enum.GetValues<ExperienceLevel>())
                    {
                        <li>
                            <input type="radio" name="experienceLevel" value="@level"
                                   checked="@(f.ExperienceLevel == level)"
                                   onchange="document.getElementById('filterForm').submit()">
                            <label>@level.ToLabel()</label>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="filter-block bottom-line pb-25 mt-25">
        <div class="filter-title fw-500 text-dark">Location</div>
        <input type="text" name="location" value="@f.Location" class="form-control" placeholder="Any location">
    </div>

    <button type="submit" class="btn-ten fw-500 text-white w-100 text-center tran3s mt-30">Apply filter</button>
    <a asp-controller="Job" asp-action="JobList" class="btn-ten fw-500 w-100 text-center tran3s mt-10">Reset</a>
</form>

@*
   ---------------------------------------------------------------------------
   4) Results header (line ~279) - real count and a working sort dropdown.
   ---------------------------------------------------------------------------
*@

<div class="upper-filter d-flex justify-content-between align-items-center mb-20">
    <div class="total-job-found">
        All <span class="text-dark">@Model.Jobs.TotalCount.ToString("N0")</span> jobs found
    </div>
    <div class="d-flex align-items-center">
        <div class="short-filter d-flex align-items-center">
            <div class="text-dark fw-500 me-2">Sort:</div>
            <select class="nice-select" onchange="window.location.href = this.value">
                <option value="@Url.Action("JobList", "Job", new { search = f.Search, categorySlug = f.CategorySlug, jobType = f.JobType, experienceLevel = f.ExperienceLevel, location = f.Location, sortBy = "createdAt", descending = true })">Latest</option>
                <option value="@Url.Action("JobList", "Job", new { search = f.Search, categorySlug = f.CategorySlug, jobType = f.JobType, experienceLevel = f.ExperienceLevel, location = f.Location, sortBy = "title", descending = false })">Title A-Z</option>
                <option value="@Url.Action("JobList", "Job", new { search = f.Search, categorySlug = f.CategorySlug, jobType = f.JobType, experienceLevel = f.ExperienceLevel, location = f.Location, sortBy = "salary", descending = true })">Salary (high to low)</option>
            </select>
        </div>
    </div>
</div>

@*
   ---------------------------------------------------------------------------
   5) The nine hardcoded job cards (lines ~295-528) - replace all of them with
      this single loop.
   ---------------------------------------------------------------------------
*@

<div class="accordion-box list-style show">
    @if (Model.IsEmpty)
    {
        <div class="text-center pt-60 pb-60">
            <h4 class="fw-500">No jobs match your filters.</h4>
            <p class="text-md mt-10">Try clearing a filter or searching for a different keyword.</p>
            <a asp-controller="Job" asp-action="JobList" class="btn-ten fw-500 text-white tran3s mt-20">Clear filters</a>
        </div>
    }
    else
    {
        @foreach (var job in Model.Jobs.Items)
        {
            <div class="job-list-one style-two position-relative border-style mb-20">
                <div class="row justify-content-between align-items-center">
                    <div class="col-md-5">
                        <div class="job-title d-flex align-items-center">
                            <a asp-action="JobDetails" asp-route-slug="@job.Slug" class="logo">
                                <img src="~/images/lazy.svg" data-src="/images/logo/media_22.png" alt="@job.CompanyName" class="lazy-img m-auto">
                            </a>
                            <div class="split-box1">
                                <span class="job-duration fw-500">@job.JobType.ToLabel()</span>
                                <a asp-action="JobDetails" asp-route-slug="@job.Slug" class="title fw-500 tran3s">@job.Title</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 col-sm-6">
                        <div class="job-location">
                            <a asp-action="JobDetails" asp-route-slug="@job.Slug">@job.Location</a>
                        </div>
                        <div class="job-salary">
                            <span class="fw-500 text-dark">@job.SalaryRange</span> . @job.ExperienceLevel.ToLabel()
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="btn-group d-flex align-items-center justify-content-sm-end xs-mt-20">
                            <a asp-action="JobDetails" asp-route-slug="@job.Slug" class="save-btn text-center rounded-circle tran3s me-3" title="Save Job">
                                <i class="bi bi-bookmark-dash"></i>
                            </a>
                            <a asp-action="JobDetails" asp-route-slug="@job.Slug" class="apply-btn text-center tran3s">APPLY</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@*
   ---------------------------------------------------------------------------
   6) Pagination (line ~670) - replace the hardcoded <ul class="pagination-one">.
   ---------------------------------------------------------------------------
*@

@if (Model.Jobs.TotalPages > 1)
{
    <ul class="pagination-one d-flex align-items-center justify-content-center justify-content-sm-start style-none">
        @if (Model.Jobs.HasPreviousPage)
        {
            <li><a asp-action="JobList" asp-all-route-data="Model.RouteValuesFor(Model.Jobs.Page - 1)">Prev</a></li>
        }

        @for (var p = 1; p <= Model.Jobs.TotalPages; p++)
        {
            <li class="@(p == Model.Jobs.Page ? "active" : "")">
                <a asp-action="JobList" asp-all-route-data="Model.RouteValuesFor(p)">@p</a>
            </li>
        }

        @if (Model.Jobs.HasNextPage)
        {
            <li class="ms-2">
                <a asp-action="JobList" asp-all-route-data="Model.RouteValuesFor(Model.Jobs.Page + 1)" class="d-flex align-items-center">
                    Next <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        }
    </ul>
}
