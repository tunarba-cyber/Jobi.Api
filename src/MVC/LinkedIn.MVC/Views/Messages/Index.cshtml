@model LinkedIn.MVC.Models.ViewModels.ConversationsViewModel
@{
    ViewData["Title"] = "Messages";
}

<div class="inner-banner-one position-relative">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 m-auto text-center">
                <div class="title-two"><h2 class="text-white">Messages</h2></div>
            </div>
        </div>
    </div>
</div>

<section class="pt-100 lg-pt-80 pb-150 lg-pb-80">
    <div class="container">

        <div class="mb-30">
            <input id="userSearch" class="form-control" placeholder="Search by name to start a conversation..." autocomplete="off" />
            <div id="userResults" class="list-group mt-5"></div>
        </div>

        <form id="startForm" asp-action="Send" method="post" style="display:none;">
            <input type="hidden" name="recipientUserId" id="recipientUserId" />
            <input type="hidden" name="content" value="Hi!" />
        </form>

        @if (Model.Items.Count == 0)
        {
            <p class="text-center">No conversations yet.</p>
        }
        else
        {
            @foreach (var c in Model.Items)
            {
                <a asp-action="Thread" asp-route-id="@c.Id" class="d-block job-list-one style-two position-relative border-style mb-15 p-20">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="fw-500">@c.OtherUserId</div>
                            <div class="text-muted small">@c.LastMessage</div>
                        </div>
                        @if (c.UnreadCount > 0)
                        {
                            <span class="badge bg-primary">@c.UnreadCount</span>
                        }
                    </div>
                </a>
            }
        }
    </div>
</section>

@section Scripts {
    <script>
        const searchBox = document.getElementById('userSearch');
        const results = document.getElementById('userResults');
        let timer;

        searchBox.addEventListener('input', function() {
            clearTimeout(timer);
            const q = this.value.trim();
            if (q.length < 2) { results.innerHTML = ''; return; }

            timer = setTimeout(async () => {
                const res = await fetch('/Messages/SearchUsers?q=' + encodeURIComponent(q));
                const users = await res.json();
                results.innerHTML = users.map(u =>
                    `<button type="button" class="list-group-item list-group-item-action" onclick="startChat('${u.id}')">${u.firstName} ${u.lastName}</button>`
                ).join('');
            }, 300);
        });

        function startChat(userId) {
            document.getElementById('recipientUserId').value = userId;
            document.getElementById('startForm').submit();
        }
    </script>
}