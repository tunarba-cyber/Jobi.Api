@model LinkedIn.MVC.Models.ViewModels.ConversationViewModel
@{
    ViewData["Title"] = Model.OtherUserName;
}

<div class="inner-banner-one position-relative">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 m-auto text-center">
                <div class="title-two"><h2 class="text-white">@Model.OtherUserName</h2></div>
            </div>
        </div>
    </div>
</div>

<section class="pt-100 lg-pt-80 pb-150 lg-pb-80">
    <div class="container">
        <a asp-action="Index" class="btn btn-outline-secondary mb-30 d-inline-block"><i class="bi bi-arrow-left"></i> Back to Messages</a>

        <div class="d-flex align-items-center gap-3 mb-20">
            <span class="jb-avatar lg" style="width:52px;height:52px;font-size:1.2rem;">@(Model.OtherUserName.Length > 0 ? Model.OtherUserName[0].ToString().ToUpperInvariant() : "?")</span>
            <div class="fw-600 fs-5" style="color:var(--jb-primary);">@Model.OtherUserName</div>
        </div>

        <div class="jb-chat" id="messageBox">
            @foreach (var m in Model.Messages)
            {
                <div class="jb-msg @(m.SenderId == Model.OtherUserId ? "" : "me")">
                    <span class="jb-msg-meta">@(m.SenderId == Model.OtherUserId ? Model.OtherUserName : "You") · @m.SentAtUtc.ToString("dd MMM, HH:mm")</span>
                    <div>@m.Content</div>
                </div>
            }
        </div>

        <form asp-action="Send" method="post" class="jb-composer">
            <input type="hidden" name="recipientUserId" value="@Model.OtherUserId" />
            <input name="content" class="form-control" maxlength="4000" placeholder="Type a message..." required autocomplete="off" />
            <button type="submit" class="btn-one"><i class="bi bi-send-fill"></i> Send</button>
        </form>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
<script>
    (function() { const b = document.getElementById('messageBox'); if (b) b.scrollTop = b.scrollHeight; })();
</script>
<script>
    (async function() {
        const otherUserId = @Json.Serialize(Model.OtherUserId);
        const otherUserName = @Json.Serialize(Model.OtherUserName);
        const apiBaseUrl = @Json.Serialize((string?)ViewBag.ApiBaseUrl);
        const accessToken = @Json.Serialize((string?)ViewBag.AccessToken);

        const connection = new signalR.HubConnectionBuilder()
            .withUrl(apiBaseUrl + "/hubs/chat", { accessTokenFactory: () => accessToken })
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveMessage", function(msg) {
            const box = document.getElementById('messageBox');
            const row = document.createElement('div');
            row.className = 'jb-msg' + (msg.senderId === otherUserId ? '' : ' me');
            const who = document.createElement('span');
            who.className = 'jb-msg-meta';
            who.textContent = msg.senderId === otherUserId ? otherUserName : 'You';
            const body = document.createElement('div');
            body.textContent = msg.content;
            row.append(who, body);
            box.appendChild(row);
            box.scrollTop = box.scrollHeight;
        });

        try { await connection.start(); } catch (err) { console.error(err); }
    })();
</script>