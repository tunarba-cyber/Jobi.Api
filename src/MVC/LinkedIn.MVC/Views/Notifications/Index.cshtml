@using LinkedIn.MVC.Models
@using LinkedIn.MVC.Models.Api
@model PagedResult<NotificationDto>
@{
    ViewData["Title"] = "Notifications";
}

<div class="inner-banner-one position-relative">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 m-auto text-center">
                <div class="title-two"><h2 class="text-white">Notifications</h2></div>
            </div>
        </div>
    </div>
</div>

<section class="pt-100 lg-pt-80 pb-150 lg-pb-80">
    <div class="container">
        @if (Model.Items.Count == 0)
        {
            <div class="jb-empty">
                <div class="jb-empty-icon"><i class="bi bi-bell-slash"></i></div>
                <h4>You're all caught up</h4>
                <p>New activity on your jobs, applications and messages will show up here.</p>
            </div>
        }
        else
        {
            <div class="text-end mb-20">
                <form asp-action="MarkAllRead" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-check2-all"></i> Mark all as read</button>
                </form>
            </div>

            @foreach (var n in Model.Items)
            {
                <form asp-action="Open" method="post" class="m-0">
                    <input type="hidden" name="id" value="@n.Id" />
                    <input type="hidden" name="link" value="@n.Link" />
                    <button type="submit" class="jb-notif @(n.IsRead ? "" : "is-unread")">
                        <span class="jb-notif-icon"><i class="bi @(n.IsRead ? "bi-bell" : "bi-bell-fill")"></i></span>
                        <span class="flex-fill">
                            <span class="d-flex justify-content-between gap-3">
                                <span class="jb-notif-title @(n.IsRead ? "" : "fw-500")">
                                    @if (!n.IsRead)
                                    {
                                        <span class="jb-dot"></span>
                                    }
                                    @n.Title
                                </span>
                                <span class="jb-notif-time">@TimeDisplay.Local(n.CreatedAtUtc)</span>
                            </span>
                            @if (!string.IsNullOrWhiteSpace(n.Body))
                            {
                                <span class="jb-notif-body d-block">@n.Body</span>
                            }
                        </span>
                    </button>
                </form>
            }

            @if (Model.TotalPages > 1)
            {
                <ul class="pagination-one d-flex justify-content-center style-none mt-30">
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="@(p == Model.Page ? "active" : "")"><a asp-action="Index" asp-route-page="@p">@p</a></li>
                    }
                </ul>
            }
        }
    </div>
</section>