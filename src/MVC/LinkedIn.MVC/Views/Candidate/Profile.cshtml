@using LinkedIn.MVC.Models.Api
@using Microsoft.Extensions.Options
@model LinkedIn.MVC.Models.ViewModels.CandidateProfileViewModel
@inject IOptions<LinkedIn.MVC.Services.JobiApiOptions> ApiOptions
@{
    ViewData["Title"] = "My Profile";
    var apiBaseUrl = ApiOptions.Value.BaseUrl.TrimEnd('/');
}

<div class="inner-banner-one position-relative">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 m-auto text-center">
                <div class="title-two"><h2 class="text-white">My Profile</h2></div>
            </div>
        </div>
    </div>
</div>

<section class="pt-100 lg-pt-80 pb-150 lg-pb-80">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 m-auto">
                <div asp-validation-summary="All" class="alert alert-danger"></div>

                <form method="post" enctype="multipart/form-data">
                    <div class="row align-items-center mb-4">
                        <div class="col-auto">
                            @if (!string.IsNullOrWhiteSpace(Model.CurrentPhotoUrl))
                            {
                                <img src="@(apiBaseUrl + Model.CurrentPhotoUrl)" alt="Profile photo" class="rounded-circle" style="width:80px; height:80px; object-fit:cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center" style="width:80px; height:80px;">
                                    <i class="bi bi-person fs-2"></i>
                                </div>
                            }
                        </div>
                        <div class="col">
                            <label class="form-label fw-500">Profile photo</label>
                            <input name="Photo" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-500">Full name*</label>
                        <input name="FullName" value="@Model.FullName" class="form-control" maxlength="200" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-500">Headline*</label>
                        <input name="Headline" value="@Model.Headline" class="form-control" maxlength="200" placeholder="e.g. Senior Frontend Developer" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label class="form-label fw-500">Location</label>
                            <input name="Location" value="@Model.Location" class="form-control" maxlength="200" placeholder="Baku, Azerbaijan" />
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="form-label fw-500">Experience level</label>
                            <select name="ExperienceLevel" class="form-select">
                                @foreach (ExperienceLevel level in Enum.GetValues<ExperienceLevel>())
                                {
                                    <option value="@level" selected="@(Model.ExperienceLevel == level)">@level.ToLabel()</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-500">Skills</label>
                        <input name="Skills" value="@Model.Skills" class="form-control" maxlength="1000" placeholder="Figma, React, TypeScript" />
                        <div class="form-text">Comma-separated.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-500">Bio</label>
                        <textarea name="Bio" class="form-control" rows="6" maxlength="2000">@Model.Bio</textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-500">CV (PDF, DOC or DOCX, max 5 MB)</label>
                        @if (!string.IsNullOrWhiteSpace(Model.CurrentResumeUrl))
                        {
                            <div class="mb-10">
                                <a href="@(apiBaseUrl + Model.CurrentResumeUrl)" target="_blank" rel="noopener">View current CV</a>
                            </div>
                        }
                        <input name="Resume" type="file" class="form-control" accept=".pdf,.doc,.docx" />
                    </div>

                    <div class="mb-4 form-check">
                        <input name="IsAvailableForWork" type="checkbox" value="true" class="form-check-input" id="isAvailable" checked="@Model.IsAvailableForWork" />
                        <label class="form-check-label" for="isAvailable">Available for work</label>
                    </div>

                    <button type="submit" class="btn-one">@(Model.HasProfile ? "Save changes" : "Create profile")</button>
                </form>
            </div>
        </div>
    </div>
</section>