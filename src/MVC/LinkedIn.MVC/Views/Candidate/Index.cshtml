@using LinkedIn.MVC.Models.Api
@using LinkedIn.MVC.Models.ViewModels
@using Microsoft.Extensions.Options
@model LinkedIn.MVC.Models.ViewModels.CandidatesListViewModel
@inject IOptions<LinkedIn.MVC.Services.JobiApiOptions> ApiOptions
@{
    ViewData["Title"] = "Candidates";
    var f = Model.Filters;
    var apiBaseUrl = ApiOptions.Value.BaseUrl.TrimEnd('/');
}

<div class="inner-banner-one position-relative">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 m-auto text-center">
                <div class="title-two"><h2 class="text-white">Candidates</h2></div>
                <p class="text-lg text-white mt-15">Find talented people ready to work</p>
            </div>
        </div>
    </div>
</div>

<section class="pt-100 lg-pt-80 pb-150 lg-pb-80">
    <div class="container">
        <form asp-controller="Candidate" asp-action="Index" method="get" class="row g-3 mb-40">
            <div class="col-md-4">
                <input type="text" name="search" value="@f.Search" class="form-control" placeholder="Name or headline">
            </div>
            <div class="col-md-4">
                <input type="text" name="location" value="@f.Location" class="form-control" placeholder="Location">
            </div>
            <div class="col-md-3">
                <select name="experienceLevel" class="form-select">
                    <option value="">Any experience</option>
                    @foreach (ExperienceLevel level in Enum.GetValues<ExperienceLevel>())
                    {
                        <option value="@level" selected="@(f.ExperienceLevel == level)">@level.ToLabel()</option>
                    }
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn-one w-100">Go</button>
            </div>
        </form>

        @if (Model.IsEmpty)
        {
            <div class="text-center pt-60 pb-60">
                <h4 class="fw-500">No candidates match your search.</h4>
                <a asp-action="Index" class="btn-ten fw-500 text-white tran3s mt-20">Clear filters</a>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var candidate in Model.Candidates.Items)
                {
                    <div class="col-md-6 col-lg-4 mb-30">
                        <div class="card-style-three text-center p-30 border rounded">
                            @if (!string.IsNullOrWhiteSpace(candidate.PhotoUrl))
                            {
                                <img src="@(apiBaseUrl + candidate.PhotoUrl)" alt="@candidate.FullName" class="rounded-circle mb-15" style="width:90px; height:90px; object-fit:cover;">
                            }
                            else
                            {
                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto mb-15" style="width:90px; height:90px;">
                                    <i class="bi bi-person fs-2"></i>
                                </div>
                            }
                            <a asp-action="Details" asp-route-slug="@candidate.Slug" class="name text-md fw-500 text-dark d-block">@candidate.FullName</a>
                            <div class="post">@candidate.Headline</div>
                            @if (!string.IsNullOrWhiteSpace(candidate.Location))
                            {
                                <div class="text-muted small mt-5">@candidate.Location</div>
                            }
                            <a asp-action="Details" asp-route-slug="@candidate.Slug" class="btn btn-sm btn-outline-secondary mt-15">View profile</a>
                            <div class="mt-10">
                                <partial name="_SaveCandidateButton" model="new SaveCandidateButtonViewModel(candidate.Id, Model.SavedCandidateIds.Contains(candidate.Id))" />
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (Model.Candidates.TotalPages > 1)
            {
                <ul class="pagination-one d-flex align-items-center justify-content-center style-none mt-30">
                    @if (Model.Candidates.HasPreviousPage)
                    {
                        <li><a asp-action="Index" asp-all-route-data="Model.RouteValuesFor(Model.Candidates.Page - 1)">Prev</a></li>
                    }
                    @for (var p = 1; p <= Model.Candidates.TotalPages; p++)
                    {
                        <li class="@(p == Model.Candidates.Page ? "active" : "")"><a asp-action="Index" asp-all-route-data="Model.RouteValuesFor(p)">@p</a></li>
                    }
                    @if (Model.Candidates.HasNextPage)
                    {
                        <li class="ms-2"><a asp-action="Index" asp-all-route-data="Model.RouteValuesFor(Model.Candidates.Page + 1)">Next</a></li>
                    }
                </ul>
            }
        }
    </div>
</section>