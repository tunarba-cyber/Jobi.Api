@model LinkedIn.MVC.Models.ViewModels.ConfirmEmailResultViewModel
@{
    ViewData["Title"] = "Confirm Email";
}

<div class="inner-banner-one position-relative">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 m-auto text-center">
                <div class="title-two"><h2 class="text-white">Email Confirmation</h2></div>
            </div>
        </div>
    </div>
</div>

<section class="pt-100 lg-pt-80 pb-150 lg-pb-80">
    <div class="container text-center">
        @if (Model.Success)
        {
            <h3>Your email has been confirmed!</h3>
            <p class="text-md mt-20">You can now log in to your account.</p>
            <a href="#" class="btn-one mt-30" data-bs-toggle="modal" data-bs-target="#loginModal">Log In</a>
        }
        else
        {
            <h3>We couldn't confirm your email</h3>
            <p class="text-md mt-20">@(Model.ErrorMessage ?? "This confirmation link may have expired or already been used.")</p>
            <a asp-controller="Home" asp-action="Index" class="btn-one mt-30">Back to Home</a>
        }
    </div>
</section>