@model string
@{
    ViewData["Title"] = "Resend Confirmation";
}

<div class="inner-banner-one position-relative">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 m-auto text-center">
                <div class="title-two"><h2 class="text-white">Confirm Your Email</h2></div>
            </div>
        </div>
    </div>
</div>

<section class="pt-100 lg-pt-80 pb-150 lg-pb-80">
    <div class="container text-center">
        <p class="text-md">Enter the email you registered with and we'll send a new confirmation link.</p>
        @await Html.PartialAsync("_ResendConfirmationForm", Model)
    </div>
</section>