@model LinkedIn.MVC.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="inner-banner-one position-relative">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 m-auto text-center">
                <div class="title-two"><h2 class="text-white">Choose a New Password</h2></div>
            </div>
        </div>
    </div>
</div>

<section class="pt-100 lg-pt-80 pb-150 lg-pb-80">
    <div class="container">
        <div class="row">
            <div class="col-lg-5 m-auto">
                <div asp-validation-summary="All" class="alert alert-danger"></div>
                <form asp-action="ResetPassword" method="post" data-validate>
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Token" />
                    <div class="mb-4">
                        <label class="form-label fw-500">New password</label>
                        <input asp-for="NewPassword" type="password" class="form-control" required minlength="8"
                               pattern="(?=.*\d)(?=.*[A-Z])(?=.*[a-z]).{8,}"
                               title="At least 8 characters with an uppercase letter, a lowercase letter and a digit" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-500">Confirm password</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" required />
                    </div>
                    <button type="submit" class="btn-one w-100">Change password</button>
                </form>
            </div>
        </div>
    </div>
</section>