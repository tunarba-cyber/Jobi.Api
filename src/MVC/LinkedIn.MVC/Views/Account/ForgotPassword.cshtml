@model LinkedIn.MVC.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="inner-banner-one position-relative">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 m-auto text-center">
                <div class="title-two"><h2 class="text-white">Forgot Password</h2></div>
            </div>
        </div>
    </div>
</div>

<section class="pt-100 lg-pt-80 pb-150 lg-pb-80">
    <div class="container">
        <div class="row">
            <div class="col-lg-5 m-auto">
                <div asp-validation-summary="All" class="alert alert-danger"></div>
                <form asp-action="ForgotPassword" method="post" data-validate>
                    <div class="mb-4">
                        <label class="form-label fw-500">Email</label>
                        <input asp-for="Email" type="email" class="form-control" required />
                    </div>
                    <button type="submit" class="btn-one w-100">Send reset link</button>
                </form>
            </div>
        </div>
    </div>
</section>v