@using LinkedIn.MVC.Models.ViewModels
@using Microsoft.Extensions.Options
@model CompanyDetailsViewModel
@inject IOptions<LinkedIn.MVC.Services.JobiApiOptions> ApiOptions
@{
    ViewData["Title"] = Model.Company.Name;
    var c = Model.Company;
    var apiBase = ApiOptions.Value.BaseUrl.TrimEnd('/');
    var loggedIn = User.Identity?.IsAuthenticated == true;
}

<div class="inner-banner-one position-relative">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 m-auto text-center">
                <div class="title-two"><h2 class="text-white">@c.Name</h2></div>
            </div>
        </div>
    </div>
</div>

<section class="pt-100 lg-pt-80 pb-150 lg-pb-80">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 mb-40">
                <div class="jb-card p-30 text-center" style="position:sticky; top:100px;">
                    @if (!string.IsNullOrWhiteSpace(c.LogoUrl))
                    {
                        <span class="jb-logo-box mb-15" style="width:110px;height:110px;"><img src="@(apiBase + c.LogoUrl)" alt="@c.Name" /></span>
                    }
                    else
                    {
                        <div class="jb-avatar xl mb-15" style="width:110px;height:110px;font-size:2.6rem;border-radius:20px;">
                            @c.Name[0].ToString().ToUpperInvariant()
                        </div>
                    }
                    <h4 class="fw-700" style="color:var(--jb-primary);">@c.Name</h4>
                    @if (!string.IsNullOrWhiteSpace(c.WebsiteUrl))
                    {
                        <a href="@c.WebsiteUrl" target="_blank" rel="noopener" class="d-block mb-15 text-truncate"><i class="bi bi-link-45deg"></i> @c.WebsiteUrl</a>
                    }
                    <div class="row g-2 my-20">
                        <div class="col-6"><div class="p-3 rounded-3" style="background:var(--jb-soft);"><div class="fw-700 fs-4" style="color:var(--jb-primary);">@c.Followers</div><div class="text-muted small">Followers</div></div></div>
                        <div class="col-6"><div class="p-3 rounded-3" style="background:var(--jb-soft);"><div class="fw-700 fs-4" style="color:var(--jb-primary);">@c.OpenJobs</div><div class="text-muted small">Open jobs</div></div></div>
                    </div>

                    @if (c.IsOwner)
                    {
                        <a asp-controller="Employer" asp-action="CompanyProfile" class="btn-one w-100 text-center">Edit your company</a>
                    }
                    else if (loggedIn && !User.IsInRole("Admin"))
                    {
                        @await Html.PartialAsync("_FollowButton", new FollowButtonViewModel("Company", c.Id.ToString(), c.IsFollowing))
                    }
                    else if (!loggedIn)
                    {
                        <a href="#" data-bs-toggle="modal" data-bs-target="#loginModal" class="btn btn-outline-primary w-100">Log in to follow</a>
                    }

                    @if (loggedIn && !c.IsOwner)
                    {
                        <div class="mt-10">
                            <a asp-controller="Home" asp-action="ContactUs" asp-route-topic="ReportCompany"
                               asp-route-reference="@Url.Action("Details", "Company", new { slug = c.Slug })" class="text-muted small"><i class="bi bi-flag"></i> Report this company</a>
                        </div>
                    }
                    <div class="text-muted small mt-15"><i class="bi bi-calendar3"></i> On Jobi since @c.CreatedAtUtc.ToString("MMM yyyy")</div>
                </div>
            </div>

            <div class="col-lg-8">
                @if (!string.IsNullOrWhiteSpace(c.Description))
                {
                    <div class="jb-card p-30 mb-40">
                        <h4 class="mb-15 fw-700" style="color:var(--jb-primary);">About</h4>
                        <p class="mb-0" style="white-space:pre-wrap;">@c.Description</p>
                    </div>
                }

                <div class="jb-section-head">
                    <div>
                        <h4>Open positions</h4>
                        <p class="jb-sub">@c.OpenJobs role@(c.OpenJobs == 1 ? "" : "s") currently hiring</p>
                    </div>
                </div>
                @if (Model.Jobs.Items.Count == 0)
                {
                    <div class="jb-empty">
                        <div class="jb-empty-icon"><i class="bi bi-briefcase"></i></div>
                        <h4>No open positions right now</h4>
                        <p>Follow this company to hear about new roles.</p>
                    </div>
                }
                @foreach (var job in Model.Jobs.Items)
                {
                    <div class="jb-row jb-rise">
                        <div class="row justify-content-between align-items-center g-3">
                            <div class="col-md-8">
                                <a asp-controller="Job" asp-action="JobDetails" asp-route-slug="@job.Slug" class="title fw-600 d-block" style="color:var(--jb-primary);">@job.Title</a>
                                <div class="mt-5 d-flex flex-wrap gap-2">
                                    <span class="jb-chip"><i class="bi bi-geo-alt"></i> @job.Location</span>
                                    <span class="jb-chip"><i class="bi bi-briefcase"></i> @job.JobType</span>
                                </div>
                            </div>
                            <div class="col-md-4 text-md-end">
                                <a asp-controller="Job" asp-action="JobDetails" asp-route-slug="@job.Slug" class="apply-btn text-center tran3s">VIEW</a>
                            </div>
                        </div>
                    </div>
                }
                @if (c.OpenJobs > Model.Jobs.Items.Count)
                {
                    <a asp-controller="Job" asp-action="JobList" asp-route-search="@c.Name" class="btn-one mt-10 d-inline-block">See all @c.OpenJobs positions</a>
                }
            </div>
        </div>
    </div>
</section>