@using LinkedIn.MVC.Models.Api
@using LinkedIn.MVC.Models.ViewModels
@model IReadOnlyList<SuggestionDto>

@if (Model.Count > 0)
{
    <div class="border rounded p-20 mb-30">
        <h6 class="mb-15">Who to follow</h6>
        @foreach (var s in Model)
        {
            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                <div style="min-width:0;">
                    <a asp-controller="Posts" asp-action="Index" asp-route-authorId="@s.UserId" class="fw-500 text-dark d-block text-truncate">@s.Name</a>
                    <div class="text-muted small text-truncate">@s.Reason</div>
                </div>
                @await Html.PartialAsync("_FollowButton", new FollowButtonViewModel("User", s.UserId, false))
            </div>
        }
    </div>
}