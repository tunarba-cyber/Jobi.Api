<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>@ViewData["Title"] - Jobi</title>

    <!-- SEO & Open Graph Meta Tags -->
    <meta name="keywords" content="Digital marketing agency, Digital marketing company, Digital marketing services">
    <meta name="description" content="Jobi is a beautiful website template designed for job board websites.">
    <meta property="og:site_name" content="Jano">
    <meta property="og:url" content="https://creativegigstf.com">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Jobi - Responsive Job Board HTML Template">
    <meta property="og:image" content="~/images/assets/ogg.png">

    <!-- Mobile Navigation Bar Styling -->
    <meta name="theme-color" content="#244034">
    <meta name="msapplication-navbutton-color" content="#244034">
    <meta name="apple-mobile-web-app-status-bar-style" content="#244034">

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="56x56" href="~/images/fav-icon/icon.png">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="~/css/bootstrap.min.css" media="all">
    <link rel="stylesheet" href="~/css/style.css" media="all">
    <link rel="stylesheet" href="~/css/responsive.css" media="all">
    <link rel="stylesheet" href="~/css/jobi-theme.css" asp-append-version="true" media="all">

    <!-- Legacy Browser Polyfills -->
    <script src="~/vendor/html5shiv.js"></script>
    <script src="~/vendor/respond.js"></script>
</head>
<body>
    <div class="main-page-wrapper">
        <!-- Loading Transition -->
        <div id="preloader">
            <div id="ctn-preloader" class="ctn-preloader">
                <div class="icon"><img src="~/images/loader.svg" alt="" class="m-auto d-block" width="60"></div>
                <div class="txt-loading">
                    <span data-text-preloader="j" class="letters-loading">j</span>
                    <span data-text-preloader="o" class="letters-loading">o</span>
                    <span data-text-preloader="b" class="letters-loading">b</span>
                    <span data-text-preloader="i" class="letters-loading">i</span>
                </div>
            </div>
        </div>

        <!-- Theme Main Menu -->
        <header class="theme-main-menu menu-overlay menu-style-one sticky-menu">
            <div class="inner-content position-relative">
                <div class="top-header">
                    <div class="d-flex align-items-center">
                        <div class="logo order-lg-0">
                            <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center">
                                <img src="~/images/logo/logo_01.png" alt="">
                            </a>
                        </div>
                        <!-- logo -->
                        <div class="right-widget ms-auto order-lg-3">
                            <ul class="d-flex align-items-center style-none">
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    if (User.IsInRole("Admin"))
                                    {
                                        <li class="ms-3 dropdown">
                                            <a class="fw-500 dropdown-toggle text-nowrap" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Manage</a>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li><a asp-controller="Admin" asp-action="Analytics" class="dropdown-item"><span>Analytics</span></a></li>
                                                <li><a asp-controller="Admin" asp-action="Blogs" class="dropdown-item"><span>Manage Blogs</span></a></li>
                                                <li><a asp-controller="Admin" asp-action="Categories" class="dropdown-item"><span>Blog Categories</span></a></li>
                                                <li><a asp-controller="Admin" asp-action="JobCategories" class="dropdown-item"><span>Job Categories</span></a></li>
                                                <li><a asp-controller="Admin" asp-action="Jobs" class="dropdown-item"><span>Moderate Jobs</span></a></li>
                                                <li><a asp-controller="Admin" asp-action="Users" class="dropdown-item"><span>Users</span></a></li>
                                                <li><a asp-controller="Admin" asp-action="ContactMessages" class="dropdown-item"><span>Inbox</span></a></li>
                                                <li><a asp-controller="Admin" asp-action="Companies" class="dropdown-item"><span>Companies</span></a></li>
                                                <li><a asp-controller="Posts" asp-action="Index" class="dropdown-item"><span>Posts</span></a></li>
                                            </ul>
                                        </li>
                                    }
                                    else if (User.IsInRole("Employer"))
                                    {
                                        <li class="d-none d-md-block"><a asp-controller="Employer" asp-action="PostJob" class="job-post-btn tran3s">Post Job</a></li>
                                        <li class="ms-3 dropdown">
                                            <a class="fw-500 dropdown-toggle text-nowrap" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Employer</a>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li><a asp-controller="Employer" asp-action="Index" class="dropdown-item"><span>My Jobs</span></a></li>
                                                <li><a asp-controller="Employer" asp-action="CompanyProfile" class="dropdown-item"><span>Edit Company</span></a></li>
                                                <li><a asp-controller="SavedCandidates" asp-action="Index" class="dropdown-item"><span>Saved Candidates</span></a></li>
                                                <li><a asp-controller="Interviews" asp-action="Manage" class="dropdown-item"><span>Interviews</span></a></li>
                                                <li><a asp-controller="Employer" asp-action="Analytics" class="dropdown-item"><span>Analytics</span></a></li>
                                            </ul>
                                        </li>
                                    }
                                    else if (User.IsInRole("Candidate"))
                                    {
                                        <li class="ms-3 dropdown">
                                            <a class="fw-500 dropdown-toggle text-nowrap" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">My Account</a>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li><a asp-controller="Candidate" asp-action="Profile" class="dropdown-item"><span>My Profile</span></a></li>
                                                <li><a asp-controller="Application" asp-action="My" class="dropdown-item"><span>My Applications</span></a></li>
                                                <li><a asp-controller="SavedJobs" asp-action="Index" class="dropdown-item"><span>Saved Jobs</span></a></li>
                                                <li><a asp-controller="JobAlerts" asp-action="Index" class="dropdown-item"><span>Job Alerts</span></a></li>
                                                <li><a asp-controller="Interviews" asp-action="My" class="dropdown-item"><span>Interviews</span></a></li>
                                            </ul>
                                        </li>
                                    }

                                    @if (!User.IsInRole("Admin"))
                                    {
                                        <li class="ms-3"><a asp-controller="Messages" asp-action="Index" class="fw-500">Messages</a></li>
                                    }

                                    <li class="ms-3">
                                        <a asp-controller="Notifications" asp-action="Index" class="fw-500">
                                            <i class="bi bi-bell"></i> <span id="notifBadge" class="badge bg-danger" style="display:none;"></span>
                                        </a>
                                    </li>
                                    <li class="ms-3 fw-500">@User.Identity.Name</li>
                                    <li class="ms-3">
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="mt-10">
                                            <button type="submit" class="login-btn-one" style="background:none;border:none;">Logout</button>
                                        </form>
                                    </li>
                                }
                                else
                                {
                                    <li class="d-none d-md-block"><a asp-controller="Job" asp-action="JobList" class="job-post-btn tran3s">Post Job</a></li>
                                    <li><a href="#" class="login-btn-one" data-bs-toggle="modal" data-bs-target="#loginModal">Login</a></li>
                                    <li class="d-none d-md-block ms-4"><a asp-controller="Candidate" asp-action="Index" class="btn-one">Hire Top Talents</a></li>
                                }
                            </ul>
                        </div> <!--/.right-widget-->
                        <nav class="navbar navbar-expand-lg p0 ms-lg-5 ms-3 order-lg-2">
                            <button class="navbar-toggler d-block d-lg-none" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false"
                                    aria-label="Toggle navigation">
                                <span></span>
                            </button>
                            <div class="collapse navbar-collapse" id="navbarNav">
                                <ul class="navbar-nav align-items-lg-center">
                                    <li class="d-block d-lg-none">
                                        <div class="logo">
                                            <a asp-controller="Home" asp-action="Index" class="d-block">
                                                <img src="~/images/logo/logo_01.png" alt="" width="100">
                                            </a>
                                        </div>
                                    </li>
                                    <li class="nav-item dropdown category-btn mega-dropdown-sm">
                                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"><i class="bi bi-grid-fill"></i> Category</a>
                                        <ul class="dropdown-menu category-dropdown">
                                            @await Component.InvokeAsync("CategoryMenu")
                                        </ul>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Home" asp-action="Index" role="button">Home</a>
                                    </li>
                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                            Job
                                        </a>
                                        <ul class="dropdown-menu">
                                            <li><a asp-controller="Job" asp-action="JobList" class="dropdown-item"><span>Job List</span></a></li>
                                            <li><a asp-controller="Job" asp-action="JobGrid" class="dropdown-item"><span>Job Grid</span></a></li>
                                        </ul>
                                    </li>
                                    <li class="nav-item dropdown mega-dropdown-sm">
                                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                            Explore
                                        </a>
                                        <ul class="dropdown-menu">
                                            <li class="row gx-1">
                                                <div class="col-md-4">
                                                    <div class="menu-column">
                                                        <h6 class="mega-menu-title">Candidates</h6>
                                                        <ul class="style-none mega-dropdown-list">
                                                            <li><a asp-controller="Candidate" asp-action="Index" class="dropdown-item"><span>Candidates List</span></a></li>
                                                        </ul>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="menu-column">
                                                        <h6 class="mega-menu-title">Company</h6>
                                                        <ul class="style-none mega-dropdown-list">
                                                            <li><a asp-controller="Company" asp-action="Index" class="dropdown-item"><span>Companies</span></a></li>
                                                        </ul>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="menu-column">
                                                        <h6 class="mega-menu-title">Essential</h6>
                                                        <ul class="style-none mega-dropdown-list">
                                                            <li><a asp-controller="Home" asp-action="AboutUs" class="dropdown-item"><span>About Us</span></a></li>
                                                            <li><a asp-controller="Home" asp-action="Faq" class="dropdown-item"><span>Faq's</span></a></li>
                                                            <li><a asp-controller="Account" asp-action="SignUp" class="dropdown-item"><span>Register</span></a></li>
                                                        </ul>
                                                    </div>
                                                </div>
                                                @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin"))
                                                {
                                                    <div class="col-md-4">
                                                        <div class="menu-column">
                                                            <h6 class="mega-menu-title">Community</h6>
                                                            <ul class="style-none mega-dropdown-list">
                                                                <li><a asp-controller="Posts" asp-action="Index" class="dropdown-item"><span>Community Feed</span></a></li>
                                                                <li><a asp-controller="Follow" asp-action="Users" class="dropdown-item"><span>Explore Users</span></a></li>
                                                                <li><a asp-controller="Follow" asp-action="Companies" class="dropdown-item"><span>Explore Companies</span></a></li>
                                                                <li><a asp-controller="Follow" asp-action="Index" class="dropdown-item"><span>My Network</span></a></li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                }
                                            </li>
                                        </ul>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Blog" asp-action="Index" role="button">Blog</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Home" asp-action="ContactUs" role="button">Contact</a>
                                    </li>
                                    <li class="d-md-none"><a asp-controller="Job" asp-action="JobList" class="job-post-btn tran3s">Post Job</a></li>
                                    <li class="d-md-none"><a asp-controller="Candidate" asp-action="Index" class="btn-one w-100">Hire Top Talents</a></li>
                                </ul>
                            </div>
                        </nav>
                    </div>
                </div> <!--/.top-header-->
            </div> <!-- /.inner-content -->
        </header> <!-- /.theme-main-menu -->
        @if (TempData[LinkedIn.MVC.Models.FlashKeys.Success] is string flashSuccess)
        {
            <div class="position-fixed start-50 translate-middle-x" style="top:100px; z-index:2000; min-width:320px;">
                <div class="alert alert-success alert-dismissible fade show shadow" role="alert">
                    @flashSuccess
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData[LinkedIn.MVC.Models.FlashKeys.Error] is string flashError)
        {
            <div class="position-fixed start-50 translate-middle-x" style="top:100px; z-index:2000; min-width:320px;">
                <div class="alert alert-danger alert-dismissible fade show shadow" role="alert">
                    @flashError
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

        <div>
            @RenderBody()
        </div>

        <!-- Footer One -->
        <div class="footer-one">
            <div class="container">
                <div class="inner-wrapper">
                    <div class="row">
                        <div class="col-lg-2 col-md-3 footer-intro mb-15">
                            <div class="logo mb-15">
                                <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center">
                                    <img src="~/images/logo/logo_03.png" alt="">
                                </a>
                            </div>
                            <img src="~/images/lazy.svg" data-src="~/images/shape/shape_28.svg" alt="" class="lazy-img mt-80 sm-mt-30 sm-mb-20">
                        </div>
                        <div class="col-lg-2 col-md-3 col-sm-4 mb-20">
                            <h5 class="footer-title">Services</h5>
                            <ul class="footer-nav-link style-none">
                                <li><a asp-controller="Job" asp-action="JobList">Browse Jobs</a></li>
                                <li><a asp-controller="Company" asp-action="Index">Companies</a></li>
                                <li><a asp-controller="Candidate" asp-action="Index">Candidates</a></li>
                            </ul>
                        </div>
                        <div class="col-lg-2 col-md-3 col-sm-4 mb-20">
                            <h5 class="footer-title">Company</h5>
                            <ul class="footer-nav-link style-none">
                                <li><a asp-controller="Home" asp-action="AboutUs">About us</a></li>
                                <li><a asp-controller="Blog" asp-action="Index">Blogs</a></li>
                                <li><a asp-controller="Home" asp-action="Faq">FAQ’s</a></li>
                                <li><a asp-controller="Home" asp-action="ContactUs">Contact</a></li>
                            </ul>
                        </div>
                        <div class="col-lg-2 col-md-3 col-sm-4 mb-20">
                            <h5 class="footer-title">Support</h5>
                            <ul class="footer-nav-link style-none">
                                <li><a asp-controller="Home" asp-action="Legal">Terms of use</a></li>
                                <li><a asp-controller="Home" asp-action="Legal">Terms & conditions</a></li>
                                <li><a asp-controller="Home" asp-action="Legal">Privacy</a></li>
                                <li><a asp-controller="Home" asp-action="Legal">Cookie policy</a></li>
                            </ul>
                        </div>
                        <div class="col-lg-4 mb-20 footer-newsletter">
                            <h5 class="footer-title">Get in touch</h5>
                            <p>Questions, feedback or a partnership idea? We'd love to hear it.</p>
                            <a asp-controller="Home" asp-action="ContactUs" class="btn-one">Contact us</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="bottom-footer">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-lg-4 order-lg-3 mb-15">
                            <ul class="style-none d-flex order-lg-last justify-content-center justify-content-lg-end social-icon">
                                <li><a href="#"><i class="bi bi-whatsapp"></i></a></li>
                                <li><a href="#"><i class="bi bi-dribbble"></i></a></li>
                                <li><a href="#"><i class="bi bi-instagram"></i></a></li>
                            </ul>
                        </div>
                        <div class="col-lg-4 order-lg-1 mb-15">
                            <ul class="d-flex style-none bottom-nav justify-content-center justify-content-lg-start">
                                <li><a asp-controller="Home" asp-action="Legal">Privacy & Terms.</a></li>
                                <li><a asp-controller="Home" asp-action="ContactUs"> Contact Us</a></li>
                            </ul>
                        </div>
                        <div class="col-lg-4 order-lg-2">
                            <p class="text-center mb-15">Copyright &copy; 2023 jobi inc.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div> <!-- /.footer-one -->
        <!-- Login Modal -->
        <div class="modal fade" id="loginModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-fullscreen modal-dialog-centered">
                <div class="container">
                    <div class="user-data-form modal-content">
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        <div class="text-center">
                            <h2>Hi, Welcome Back!</h2>
                            <p>Still don't have an account? <a asp-controller="Account" asp-action="SignUp">Sign up</a></p>
                        </div>
                        <div class="form-wrapper m-auto">
                            <form asp-controller="Account" asp-action="Login" method="post" class="mt-10">
                                <input type="hidden" name="ReturnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                @if (TempData["LoginError"] is string loginError)
                                {
                                    <div class="alert alert-danger">
                                        @loginError
                                        <div class="mt-5"><a asp-controller="Account" asp-action="ResendConfirmation">Resend confirmation email</a></div>
                                    </div>
                                }
                                <div class="row">
                                    <div class="col-12">
                                        <div class="input-group-meta position-relative mb-25">
                                            <label>Email*</label>
                                            <input type="email" name="Email" placeholder="you@example.com" required>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="input-group-meta position-relative mb-20">
                                            <label>Password*</label>
                                            <input type="password" name="Password" placeholder="Enter Password" class="pass_log_id" required>
                                            <span class="placeholder_icon"><span class="passVicon"><img src="~/images/icon/icon_60.svg" alt=""></span></span>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="agreement-checkbox d-flex justify-content-between align-items-center">
                                            <div>
                                                <input type="checkbox" id="remember" name="RememberMe" value="true">
                                                <label for="remember">Keep me logged in</label>
                                            </div>
                                            <a asp-controller="Account" asp-action="ForgotPassword">Forgot password?</a>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <button type="submit" class="btn-eleven fw-500 tran3s d-block mt-20">Login</button>
                                    </div>
                                </div>
                            </form>
                            <p class="text-center mt-10">Don't have an account? <a asp-controller="Account" asp-action="SignUp" class="fw-500">Sign up</a></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Scroll Top Button -->
        <button class="scroll-top">
            <i class="bi bi-arrow-up-short"></i>
        </button>
    </div> <!-- /.main-page-wrapper -->
    <!-- Required JavaScript Libraries -->
    <script src="~/vendor/jquery.min.js"></script>
    <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/vendor/wow/wow.min.js"></script>
    <script src="~/vendor/slick/slick.min.js"></script>
    <script src="~/vendor/fancybox/dist/jquery.fancybox.min.js"></script>
    <script src="~/vendor/jquery.lazy.min.js"></script>
    <script src="~/vendor/jquery.counterup.min.js"></script>
    <script src="~/vendor/jquery.waypoints.min.js"></script>
    <script src="~/vendor/nice-select/jquery.nice-select.min.js"></script>
    <script src="~/vendor/validator.js"></script>

    <!-- Main Theme Custom Script -->
    <script src="~/js/theme.js"></script>

    @if (TempData.Peek("LoginError") is not null)
    {
        <script>
            window.addEventListener('DOMContentLoaded', function() {
                new bootstrap.Modal(document.getElementById('loginModal')).show();
            });
        </script>
    }
    <partial name="_ValidationScriptsPartial" />

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            (function() {
                const badge = document.getElementById('notifBadge');
                if (!badge) return;
                async function refresh() {
                    if (document.hidden) return;
                    try {
                        const r = await fetch('@Url.Action("Count", "Notifications")', { headers: { 'Accept': 'application/json' } });
                        if (!r.ok) return;
                        const { count } = await r.json();
                        badge.textContent = count > 99 ? '99+' : count;
                        badge.style.display = count > 0 ? 'inline-block' : 'none';
                    } catch { }
                }
                refresh();
                setInterval(refresh, 45000);
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
