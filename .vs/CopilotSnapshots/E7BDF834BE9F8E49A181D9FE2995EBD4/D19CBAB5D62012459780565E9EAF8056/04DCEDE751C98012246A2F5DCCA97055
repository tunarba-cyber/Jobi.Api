@using LinkedIn.MVC.Models.Api
@model dynamic

@{
    ViewData["Title"] = "Admin Dashboard";
    var recentBlogs = Model?.RecentBlogs as IReadOnlyList<BlogListItemDto>;
    var categories = Model?.Categories as IReadOnlyList<BlogCategoryDto>;
    int totalBlogs = Model?.TotalBlogs ?? 0;
    int totalCategories = Model?.TotalCategories ?? 0;
}

<!-- Banner Section -->
<div class="inner-banner-one position-relative">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 m-auto text-center">
                <div class="title-two"><h2 class="text-white">Admin Dashboard</h2></div>
            </div>
        </div>
    </div>
</div>

<section class="pt-100 lg-pt-80 pb-150 lg-pb-80">
    <div class="container">
        <!-- Statistics Section -->
        <div class="d-flex justify-content-between align-items-center flex-wrap mb-40">
            <div>
                <h3>Overview</h3>
            </div>
            <div class="mt-3 mt-md-0">
                <a asp-action="CreateBlog" class="btn-one">+ Create Blog</a>
            </div>
        </div>

        <!-- Stats Grid -->
        <div class="row mb-50">
            <div class="col-md-6 col-lg-3 mb-20">
                <div class="dash-card-box">
                    <div class="d-flex align-items-center">
                        <div class="flex-fill">
                            <h4 class="mb-0">@totalBlogs</h4>
                            <p class="text-muted mb-0">Total Blogs</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 mb-20">
                <div class="dash-card-box">
                    <div class="d-flex align-items-center">
                        <div class="flex-fill">
                            <h4 class="mb-0">@totalCategories</h4>
                            <p class="text-muted mb-0">Categories</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 mb-20">
                <div class="dash-card-box">
                    <div class="d-flex align-items-center">
                        <div class="flex-fill">
                            <h4 class="mb-0">@(recentBlogs?.Count(b => b.PublishedAt.HasValue) ?? 0)</h4>
                            <p class="text-muted mb-0">Published</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 mb-20">
                <div class="dash-card-box">
                    <div class="d-flex align-items-center">
                        <div class="flex-fill">
                            <h4 class="mb-0">@(recentBlogs?.Count(b => !b.PublishedAt.HasValue) ?? 0)</h4>
                            <p class="text-muted mb-0">Drafts</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Blogs Table -->
        <div class="row">
            <div class="col-lg-8">
                <div class="d-flex justify-content-between align-items-center mb-30">
                    <h4>Recent Blogs</h4>
                    <a asp-action="Blogs" class="btn btn-outline-secondary btn-sm">View All</a>
                </div>

                @if (recentBlogs?.Count() == 0)
                {
                    <div class="text-center">
                        <p class="text-muted">No blog posts yet.</p>
                        <a asp-action="CreateBlog" class="btn-one mt-20">Create your first blog</a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Category</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var blog in recentBlogs?.Take(8) ?? [])
                                {
                                    <tr>
                                        <td class="fw-500">@blog.Title</td>
                                        <td>@(blog.CategoryName ?? "-")</td>
                                        <td>
                                            @if (blog.PublishedAt.HasValue)
                                            {
                                                <span class="badge bg-success">Published</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Draft</span>
                                            }
                                        </td>
                                        <td>@blog.PublishedAt?.ToString("dd MMM yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <!-- Quick Links -->
                <h4 class="mb-30">Quick Links</h4>
                <div class="mb-30">
                    <a asp-action="CreateBlog" class="btn-one d-block mb-15" style="display: block;">Create Blog Post</a>
                    <a asp-action="Categories" class="btn btn-outline-secondary d-block text-center">Manage Categories</a>
                </div>

                <!-- Categories List -->
                <h4 class="mb-20">Categories</h4>
                @if (categories?.Count() == 0)
                {
                    <p class="text-muted">No categories yet.</p>
                }
                else
                {
                    <div class="list-wrap">
                        @foreach (var category in categories?.Take(10) ?? [])
                        {
                            <div class="d-flex justify-content-between align-items-center mb-15 pb-15" style="border-bottom: 1px solid #e9e9e9;">
                                <span class="fw-500">@category.Name</span>
                                <span style="background: #f4f4f4; padding: 4px 10px; border-radius: 4px; font-size: 12px;">@category.Count</span>
                            </div>
                        }
                    </div>
                    <a asp-action="Categories" class="btn btn-outline-secondary btn-sm w-100 mt-20">View All Categories</a>
                }
            </div>
        </div>
    </div>
</section>
