@using LinkedIn.MVC.Models.Api
@{
    ViewData["Title"] = "New Blog";
}
@{
    var categories = ViewBag.Categories as IReadOnlyList<BlogCategoryDto> ?? Array.Empty<BlogCategoryDto>();
}

<!-- Banner Section -->
<div class="inner-banner-one position-relative">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 m-auto text-center">
                <div class="title-two"><h2 class="text-white">Create Blog Post</h2></div>
            </div>
        </div>
    </div>
</div>

<section class="pt-100 lg-pt-80 pb-150 lg-pb-80">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 m-auto">
                <!-- Flash Messages -->
                @if (TempData["Warning"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show mb-30" role="alert">
                        <strong>Warning:</strong> @TempData["Warning"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show mb-30" role="alert">
                        <strong>Error:</strong> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (categories.Count == 0)
                {
                    <div class="alert alert-info mb-30">
                        <h5>No Categories Available</h5>
                        <p class="mb-0">You need to create at least one blog category before creating a post. <a asp-action="Categories" class="alert-link">Create a category now</a></p>
                    </div>
                }
                else
                {
                    <form asp-action="CreateBlog" method="post">
                        <div class="mb-25">
                            <label class="form-label fw-500">Title*</label>
                            <input name="Title" class="form-control" required maxlength="200" placeholder="Enter blog title" />
                        </div>

                        <div class="mb-25">
                            <label class="form-label fw-500">Slug (optional - derived from title if left blank)</label>
                            <input name="Slug" class="form-control" placeholder="Enter URL slug" />
                        </div>

                        <div class="mb-25">
                            <label class="form-label fw-500">Category*</label>
                            <select name="CategoryId" class="form-select" required>
                                <option value="">Select a category</option>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>

                        <div class="mb-25">
                            <label class="form-label fw-500">Content*</label>
                            <textarea name="Content" class="form-control" rows="12" required placeholder="Enter blog content"></textarea>
                        </div>

                        <div class="mb-20">
                            <div class="form-check">
                                <input type="checkbox" name="IsFeatured" value="true" class="form-check-input" id="isFeatured" />
                                <label class="form-check-label" for="isFeatured">Mark as Featured</label>
                            </div>
                        </div>

                        <div class="mb-30">
                            <div class="form-check">
                                <input type="checkbox" name="IsPublished" value="true" class="form-check-input" id="isPublished" checked />
                                <label class="form-check-label" for="isPublished">Publish immediately</label>
                            </div>
                        </div>

                        <div class="d-flex gap-3">
                            <button type="submit" class="btn-one">Create Blog Post</button>
                            <a asp-action="Blogs" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</section>