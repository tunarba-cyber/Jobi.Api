@using LinkedIn.MVC.Models.Api
@model IReadOnlyList<BlogCategoryDto>
@{
    ViewData["Title"] = "Blog Categories";
}

<!-- Banner Section -->
<div class="inner-banner-one position-relative">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 m-auto text-center">
                <div class="title-two"><h2 class="text-white">Blog Categories</h2></div>
            </div>
        </div>
    </div>
</div>

<section class="pt-100 lg-pt-80 pb-150 lg-pb-80">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center flex-wrap mb-40">
            <div>
                <h3>Manage Categories</h3>
            </div>
        </div>

        <!-- Add Category Form -->
        <div class="mb-40">
            <form asp-action="CreateCategory" method="post">
                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group mb-20">
                            <input name="name" class="form-control" placeholder="New category name" required />
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <button type="submit" class="btn-one w-100">+ Add Category</button>
                    </div>
                </div>
            </form>
        </div>

        @if (Model.Count == 0)
        {
            <div class="text-center py-60">
                <p class="text-muted mb-20">No categories yet. Create one to get started.</p>
                <button type="button" class="btn-one" onclick="document.querySelector('input[name=\"name\"]').focus();">Create First Category</button>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-lg-8">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Slug</th>
                                    <th class="text-end">Blog Count</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model)
                                {
                                    <tr>
                                        <td class="fw-500">@c.Name</td>
                                        <td><code style="background: #f4f4f4; padding: 4px 8px; border-radius: 4px;">@c.Slug</code></td>
                                        <td class="text-end">
                                            <span style="background: #f4f4f4; padding: 6px 12px; border-radius: 4px; display: inline-block;">@c.Count</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="alert alert-info">
                        <h6 class="mb-10">Categories Summary</h6>
                        <p class="mb-0 text-muted">Total: <strong>@Model.Count</strong> categories</p>
                        <p class="mb-0 text-muted">Total Posts: <strong>@Model.Sum(c => c.Count)</strong></p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>