@using LinkedIn.MVC.Models.Api
@model IReadOnlyList<BlogListItemDto>
@{
    ViewData["Title"] = "Manage Blogs";
}

<!-- Banner Section -->
<div class="inner-banner-one position-relative">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 m-auto text-center">
                <div class="title-two"><h2 class="text-white">Manage Blogs</h2></div>
            </div>
        </div>
    </div>
</div>

<section class="pt-100 lg-pt-80 pb-150 lg-pb-80">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center flex-wrap mb-40">
            <div>
                <h3>All Blog Posts</h3>
            </div>
            <div class="mt-3 mt-md-0">
                <a asp-action="CreateBlog" class="btn-one">+ Create Blog</a>
            </div>
        </div>

        @if (Model.Count == 0)
        {
            <div class="text-center py-60">
                <p class="text-muted mb-20">No blog posts yet. Start by creating your first blog post.</p>
                <a asp-action="CreateBlog" class="btn-one">Create your first blog</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Featured</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model)
                        {
                            <tr>
                                <td class="fw-500">@b.Title</td>
                                <td>@(b.CategoryName ?? "-")</td>
                                <td>
                                    @if (b.IsFeatured)
                                    {
                                        <span class="badge bg-info">Featured</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (b.PublishedAt.HasValue)
                                    {
                                        <span class="badge bg-success">Published</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Draft</span>
                                    }
                                </td>
                                <td>@b.PublishedAt?.ToString("dd MMM yyyy")</td>
                                <td class="text-end text-nowrap">
                                    <form asp-action="DeleteBlog" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this blog post? This cannot be undone.');">
                                        <input type="hidden" name="id" value="@b.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>